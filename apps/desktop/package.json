{
  "name": "@ling-stack/desktop",
  "version": "0.0.0",
  "description": "Ling Stack desktop shell with shared Web UI and Computer Use picture-in-picture.",
  "license": "MIT",
  "author": "Ling Stack contributors",
  "type": "module",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "corepack pnpm build:office-driver && corepack pnpm --filter @ling-stack/browser-host build && corepack pnpm --filter @ling-stack/chrome-extension build && corepack pnpm --filter @ling-stack/web build && corepack pnpm --filter @ling-stack/daemon build && tsc -p tsconfig.main.json && esbuild preload/main-window.ts preload/computer-use-preview.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/preload --out-extension:.js=.cjs && esbuild ../../packages/daemon/dist/cli.js --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __lingCreateRequire } from 'node:module'; const require = __lingCreateRequire(import.meta.url);\" --outfile=dist/daemon/cli.mjs && vite build --config vite.config.ts",
    "build:office-driver": "node scripts/build-office-driver.mjs",
    "typecheck": "corepack pnpm --filter @ling-stack/browser-host build && corepack pnpm --filter @ling-stack/ui-react build && corepack pnpm --filter @ling-stack/api-client build && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "corepack pnpm build && electron .",
    "start": "electron .",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm build && node --test tests/*.test.mjs && playwright test --config tests/playwright.renderer.config.mjs && playwright test tests/computer-use-preview-a11y.spec.mjs --workers=1 --reporter=line --output=test-results/computer-use-preview-a11y",
    "test:renderer": "vite build --config vite.config.ts && playwright test --config tests/playwright.renderer.config.mjs && playwright test tests/computer-use-preview-a11y.spec.mjs --workers=1 --reporter=line --output=test-results/computer-use-preview-a11y",
    "test:renderer:a11y": "vite build --config vite.config.ts && playwright test tests/computer-use-preview-a11y.spec.mjs --workers=1 --reporter=line --output=test-results/computer-use-preview-a11y",
    "performance:computer-use": "corepack pnpm build && node --expose-gc tests/computer-use-performance-harness.mjs",
    "performance:computer-use:real": "corepack pnpm build && node --expose-gc tests/computer-use-performance-harness.mjs --real",
    "smoke:computer-use": "corepack pnpm build && node tests/run-computer-use-smoke.mjs",
    "smoke:computer-use:real": "corepack pnpm build && node tests/run-computer-use-smoke.mjs --real",
    "smoke:continuity:mac": "node tests/run-packaged-continuity-smoke.mjs",
    "smoke:computer-use:windows-provider": "corepack pnpm build && node tests/run-windows-provider-smoke.mjs",
    "smoke:chrome-extension:real": "corepack pnpm --filter @ling-stack/browser-host build && corepack pnpm --filter @ling-stack/browser-host build:native && corepack pnpm --filter @ling-stack/chrome-extension build && corepack pnpm --filter @ling-stack/daemon build && node tests/chrome-extension-real-smoke.mjs",
    "verify:release-schemas": "node tests/validate-release-evidence-schemas.mjs",
    "verify:windows-provider": "node tests/verify-windows-cua-driver-provider.mjs",
    "produce:windows-acceptance-handoff": "node tests/produce-windows-acceptance-handoff.mjs",
    "test:cua-driver-source-build": "node --test tests/cua-driver-source-build.test.mjs tests/cua-driver-source-build-promotion.test.mjs tests/cua-driver-swift-archive-normalizer.test.mjs",
    "verify:cua-driver-source-build": "node scripts/verify-cua-driver-source-build.mjs",
    "promote:cua-driver-source-build": "node scripts/promote-cua-driver-source-build.mjs",
    "stage:cua-driver-provider": "node scripts/cua-driver-package-staging.mjs",
    "test:cua-driver-package-staging": "node --test tests/cua-driver-package-staging.test.mjs",
    "test:signing-feasibility": "node --test tests/cua-driver-signing-feasibility.test.mjs",
    "build:locked-control-helper:mac": "node scripts/build-locked-control-native-helper.mjs --platform=darwin",
    "build:locked-control-probe:mac": "node scripts/build-locked-control-darwin-probe.mjs",
    "probe:locked-control:mac": "node scripts/run-locked-control-darwin-probe.mjs",
    "build:locked-control-helper:win": "powershell -ExecutionPolicy Bypass -File scripts/build-locked-control-native-helper.ps1",
    "test:locked-control-helper:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-locked-control-win32-handoff.ps1",
    "package:signing-feasibility": "node tests/run-cua-driver-signing-builder-fixture.mjs",
    "screenshots:update:computer-use": "corepack pnpm build && electron tests/screenshot-app --update",
    "screenshots:verify:computer-use": "corepack pnpm build && electron tests/screenshot-app",
    "package:mac": "corepack pnpm --filter @ling-stack/browser-host build:native && corepack pnpm build && node scripts/cua-driver-electron-package.mjs --platform darwin -- --mac dmg zip --arm64",
    "package:win": "corepack pnpm --filter @ling-stack/browser-host build:native && corepack pnpm build && node scripts/cua-driver-electron-package.mjs --platform win32-x64 -- --win nsis --x64"
  },
  "dependencies": {
    "@ling-stack/browser-host": "workspace:*",
    "@napi-rs/canvas": "1.0.7",
    "@ling-stack/api-client": "workspace:*",
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/ui-react": "workspace:*",
    "lucide-react": "^1.29.0",
    "mammoth": "1.12.1",
    "pdf-parse": "2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/osx-sign": "2.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "resedit": "3.0.2",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "com.lingstack.desktop",
    "productName": "Ling Stack",
    "afterPack": "./scripts/cua-driver-signing/after-pack.mjs",
    "afterSign": "./scripts/cua-driver-signing/after-sign.mjs",
    "artifactBuildCompleted": "./scripts/cua-driver-signing/artifact-build-completed.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/node_modules/@ling-stack/browser-host/dist/native{,/**/*}",
      "!**/node_modules/@ling-stack/browser-host/native{,/**/*}",
      "!**/node_modules/@ling-stack/browser-host/scripts{,/**/*}",
      "!**/node_modules/@ling-stack/browser-host/src{,/**/*}",
      "!**/node_modules/@ling-stack/browser-host/test{,/**/*}",
      "!**/node_modules/@ling-stack/browser-host/tsconfig.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/daemon/src/features/plugins/bundled",
        "to": "bundled",
        "filter": [
          "cua-driver/.ling-plugin/plugin.json",
          "cua-driver/mcp-server.json",
          "cua-driver/README.md"
        ]
      },
      {
        "from": "../chrome-extension/ling-for-chrome.zip",
        "to": "browser-extension/ling-for-chrome.zip"
      },
      {
        "from": "../chrome-extension/dist/build-metadata.json",
        "to": "browser-extension/build-metadata.json"
      },
      {
        "from": "../chrome-extension/README.md",
        "to": "browser-extension/README.md"
      },
      {
        "from": "../chrome-extension/STORE_SUBMISSION.md",
        "to": "browser-extension/STORE_SUBMISSION.md"
      },
      {
        "from": "dist/office-driver",
        "to": "office-driver"
      },
      {
        "from": "../../LICENSE",
        "to": "browser-extension/LICENSE"
      },
      {
        "from": "../../packages/browser-host/dist/native",
        "to": "browser-host",
        "filter": [
          "ling-browser-host",
          "ling-browser-host.exe",
          "build-metadata.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "Ling-Stack-${version}-macos-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Ling-Stack-${version}-windows-${arch}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "include": "build/installer.nsh"
    }
  }
}
