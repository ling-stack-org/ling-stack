+fn invoke_managed_set_config(state: &Arc<ToolState>, args: &Value) -> ToolResult {
+    let transaction = match cua_driver_core::ling_managed::begin_state_transaction() {
+        Ok(transaction) => transaction,
+        Err(error) => {
+            return ToolResult::error(format!(
+                "failed to begin managed config transaction: {error}"
+            ))
+        }
+    };
+    let mut next = state.config.read().unwrap().clone();
+    let mut entries = std::collections::BTreeMap::<String, Value>::new();
+
+    if let (Some(key), Some(value)) = (
+        args.get("key").and_then(Value::as_str),
+        args.get("value"),
+    ) {
+        if let Err(error) = apply_managed_config_value(key, value, &mut next, &mut entries) {
+            return ToolResult::error(error);
+        }
+    }
+    // Legacy direct fields intentionally win over the {key,value} shape, as in
+    // upstream. Unlike upstream, a present field with the wrong JSON type is a
+    // fail-closed ToolResult error rather than a silent no-op.
+    for key in [
+        "capture_mode",
+        "capture_scope",
+        "max_image_dimension",
+        "experimental_pip",
+        "experimental_pip_geometry",
+    ] {
+        if let Some(value) = args.get(key) {
+            if let Err(error) = apply_managed_config_value(key, value, &mut next, &mut entries) {
+                return ToolResult::error(error);
+            }
+        }
+    }
+    if entries.is_empty() {
+        return ToolResult::error(
+            "Missing required string field `key` (or a known legacy per-field).",
+        );
+    }
+
+    let entries: Vec<(String, Value)> = entries.into_iter().collect();
+    if let Err(error) = transaction.update_json_keys_atomic("config.json", &entries) {
+        return ToolResult::error(format!("failed to persist managed config: {error}"));
+    }
+    // Persistence is authoritative: publish the candidate to memory only after
+    // the atomic capability-root replacement has completed.
+    *state.config.write().unwrap() = next.clone();
+
+    let cursor_enabled = state
+        .cursor_registry
+        .all_states()
+        .first()
+        .map(|cursor| cursor.config.enabled)
+        .unwrap_or(true);
+    let managed_json = cua_driver_core::ling_managed::read_state("config.json")
+        .ok()
+        .flatten()
+        .and_then(|bytes| serde_json::from_slice::<Value>(&bytes).ok())
+        .unwrap_or_else(|| json!({}));
+    let pip_enabled = managed_json
+        .get("experimental_pip")
+        .and_then(Value::as_bool)
+        .unwrap_or(false);
+    let pip_geometry = managed_json
+        .get("experimental_pip_geometry")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+    let payload = json!({
+        "schema_version":      1,
+        "version":             env!("CARGO_PKG_VERSION"),
+        "platform":            "windows",
+        "capture_mode":        next.capture_mode,
+        "capture_scope":       next.capture_scope,
+        "max_image_dimension": next.max_image_dimension,
+        "agent_cursor":        { "enabled": cursor_enabled },
+        "experimental_pip":    pip_enabled,
+        "experimental_pip_geometry": pip_geometry,
+    });
+    let pretty = serde_json::to_string_pretty(&payload).unwrap_or_else(|_| payload.to_string());
+    let result = ToolResult::text(format!("✅ {pretty}")).with_structured(payload);
+    drop(transaction);
+    result
+}
+
+fn apply_managed_config_value(
+    key: &str,
+    value: &Value,
+    next: &mut DriverConfig,
+    entries: &mut std::collections::BTreeMap<String, Value>,
+) -> Result<(), String> {
+    match key {
+        "capture_mode" => {
+            let mode = value
+                .as_str()
+                .ok_or_else(|| format!("`capture_mode` must be a string, got {value}."))?;
+            next.capture_mode = mode.to_owned();
+            entries.insert(key.to_owned(), Value::String(mode.to_owned()));
+        }
+        "capture_scope" => {
+            let scope = value
+                .as_str()
+                .ok_or_else(|| format!("`capture_scope` must be a string, got {value}."))?;
+            if !matches!(scope, "window" | "desktop") {
+                return Err(format!(
+                    "`capture_scope` must be \"window\" or \"desktop\", got \"{scope}\"."
+                ));
+            }
+            next.capture_scope = scope.to_owned();
+            entries.insert(key.to_owned(), Value::String(scope.to_owned()));
+        }
+        "max_image_dimension" => {
+            let raw = value.as_u64().ok_or_else(|| {
+                format!("`max_image_dimension` must be an integer, got {value}.")
+            })?;
+            let dimension = u32::try_from(raw)
+                .map_err(|_| format!("max_image_dimension {raw} exceeds u32::MAX"))?;
+            next.max_image_dimension = dimension;
+            entries.insert(key.to_owned(), Value::from(dimension));
+        }
+        "experimental_pip" => {
+            let enabled = value.as_bool().ok_or_else(|| {
+                format!("`experimental_pip` must be a boolean, got {value}.")
+            })?;
+            entries.insert(key.to_owned(), Value::Bool(enabled));
+        }
+        "experimental_pip_geometry" => {
+            let geometry = value.as_str().ok_or_else(|| {
+                format!("`experimental_pip_geometry` must be a string, got {value}.")
+            })?;
+            if pip_preview::PipGeometry::parse(geometry).is_none() {
+                return Err(format!(
+                    "experimental_pip_geometry `{geometry}` is not a valid WxH or WxH+X+Y string"
+                ));
+            }
+            entries.insert(key.to_owned(), Value::String(geometry.to_owned()));
+        }
+        other => {
+            return Err(format!(
+                "Unknown config key `{other}`. Known: capture_mode, capture_scope, max_image_dimension, experimental_pip, experimental_pip_geometry."
+            ));
+        }
+    }
+    Ok(())
+}
