@@ -0,0 +1,49 @@
+//! Stable capability failures for Ling's standard-integrity distribution.
+
+use serde::Serialize;
+
+#[derive(Debug, Clone, Copy, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum CapabilityRequirement {
+    ElevatedPixelInput,
+    UwpSendInput,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+pub struct StructuredCapabilityError {
+    pub code: &'static str,
+    pub requirement: CapabilityRequirement,
+    pub required_integrity_coverage: &'static str,
+    pub configured_integrity_coverage: &'static str,
+}
+
+impl StructuredCapabilityError {
+    pub fn uiaccess_required(requirement: CapabilityRequirement) -> Self {
+        Self {
+            code: "cua_windows_uiaccess_required",
+            requirement,
+            required_integrity_coverage: "uiaccess",
+            configured_integrity_coverage: "standard",
+        }
+    }
+
+    pub fn to_json(&self) -> String {
+        serde_json::to_string(self)
+            .unwrap_or_else(|_| "{\"code\":\"cua_windows_uiaccess_required\"}".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn emits_stable_structured_code() {
+        let value =
+            StructuredCapabilityError::uiaccess_required(CapabilityRequirement::UwpSendInput);
+        let json: serde_json::Value = serde_json::from_str(&value.to_json()).unwrap();
+        assert_eq!(json["code"], "cua_windows_uiaccess_required");
+        assert_eq!(json["requirement"], "uwp_send_input");
+        assert_eq!(json["configured_integrity_coverage"], "standard");
+    }
+}
