+/// Classify SendInput-only targets before attempting foreground mutation.
+/// Ling-managed standard mode returns a stable JSON error. Standalone mode
+/// keeps the upstream behavior and error text.
+pub fn managed_send_input_guard(hwnd: u64) -> Option<String> {
+    if !cua_driver_core::ling_managed::is_managed() { return None; }
+    if let Some(error) = post_message_blocked_by_uipi(hwnd) { return Some(error); }
+    if keyboard::is_xaml_host_hwnd(hwnd) {
+        return Some(crate::ling_managed_capability::StructuredCapabilityError::uiaccess_required(
+            crate::ling_managed_capability::CapabilityRequirement::UwpSendInput,
+        ).to_json());
+    }
+    None
+}
