+//! Stable capability failures for Ling's standard-integrity distribution.
+
+use serde::Serialize;
+
+#[derive(Debug, Clone, Copy, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum CapabilityLimitation {
+    ElevatedPixelInput,
+    UwpSendInput,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct StructuredCapabilityError {
+    pub code: &'static str,
+    pub required_integrity_coverage: &'static str,
+    pub limitation: CapabilityLimitation,
+}
+
+impl StructuredCapabilityError {
+    pub fn uiaccess_required(limitation: CapabilityLimitation) -> Self {
+        Self {
+            code: "cua_windows_uiaccess_required",
+            required_integrity_coverage: "uiaccess",
+            limitation,
+        }
+    }
+
+    pub fn to_json(&self) -> String {
+        serde_json::to_string(self).unwrap_or_else(|_| {
+            format!(
+                "{{\"code\":\"cua_windows_uiaccess_required\",\"requiredIntegrityCoverage\":\"uiaccess\",\"limitation\":\"{}\"}}",
+                match self.limitation {
+                    CapabilityLimitation::ElevatedPixelInput => "elevated_pixel_input",
+                    CapabilityLimitation::UwpSendInput => "uwp_send_input",
+                }
+            )
+        })
+    }
+}
+
+pub fn is_exact_wire(message: &str) -> bool {
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(message) else {
+        return false;
+    };
+    let Some(object) = value.as_object() else {
+        return false;
+    };
+    object.len() == 3
+        && object.get("code").and_then(serde_json::Value::as_str)
+            == Some("cua_windows_uiaccess_required")
+        && object
+            .get("requiredIntegrityCoverage")
+            .and_then(serde_json::Value::as_str)
+            == Some("uiaccess")
+        && matches!(
+            object.get("limitation").and_then(serde_json::Value::as_str),
+            Some("elevated_pixel_input" | "uwp_send_input")
+        )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn emits_stable_structured_code() {
+        let value =
+            StructuredCapabilityError::uiaccess_required(CapabilityLimitation::UwpSendInput);
+        let json: serde_json::Value = serde_json::from_str(&value.to_json()).unwrap();
+        assert_eq!(json.as_object().unwrap().len(), 3);
+        assert_eq!(json["code"], "cua_windows_uiaccess_required");
+        assert_eq!(json["requiredIntegrityCoverage"], "uiaccess");
+        assert_eq!(json["limitation"], "uwp_send_input");
+        assert!(json.get("requirement").is_none());
+        assert!(json.get("configuredIntegrityCoverage").is_none());
+    }
+}
