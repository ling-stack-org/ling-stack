+//! Ling-owned managed-embedding environment and capability-root state access.
+//!
+//! Managed mode intentionally keeps the user's real HOME/USERPROFILE intact.
+//! Driver-owned state is instead accessed relative to one Desktop-created
+//! capability root. Every managed read/write re-opens that root without
+//! following links. Standalone mode never enters these helpers and retains the
+//! upstream path and persistence behavior byte-for-byte.
+
+use serde_json::Value;
+use std::ffi::{OsStr, OsString};
+use std::path::{Component, Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+pub const LING_MANAGED_ENV: &str = "CUA_DRIVER_LING_MANAGED";
+pub const STATE_HOME_ENV: &str = "CUA_DRIVER_STATE_HOME";
+pub const TELEMETRY_ENABLED_ENV: &str = "CUA_DRIVER_RS_TELEMETRY_ENABLED";
+pub const UPDATE_CHECK_ENV: &str = "CUA_DRIVER_RS_UPDATE_CHECK";
+pub const TELEMETRY_HOME_ENV: &str = "CUA_DRIVER_TELEMETRY_HOME";
+
+const INITIAL_DIRECTORIES: [&str; 3] = ["telemetry", "version-check", "run"];
+static STATE_RMW_LOCK: OnceLock<Mutex<()>> = OnceLock::new();
+
+pub struct ManagedStateTransaction {
+    _guard: std::sync::MutexGuard<'static, ()>,
+    root: PathBuf,
+}
+
+impl ManagedStateTransaction {
+    pub fn update_json_keys_atomic(
+        &self,
+        relative: impl AsRef<Path>,
+        entries: &[(String, Value)],
+    ) -> Result<(), String> {
+        update_json_keys_unlocked(&self.root, relative.as_ref(), entries)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ManagedEnvironment {
+    pub state_home: PathBuf,
+    pub telemetry_home: PathBuf,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ManagedEnvironmentError {
+    Missing(&'static str),
+    InvalidBoolean {
+        name: &'static str,
+        expected: &'static str,
+    },
+    InvalidStateHome,
+    InvalidTelemetryHome,
+    InvalidStateRoot(String),
+}
+
+impl std::fmt::Display for ManagedEnvironmentError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Missing(name) => write!(formatter, "{name} is required in Ling-managed mode"),
+            Self::InvalidBoolean { name, expected } => {
+                write!(formatter, "{name} must be exactly {expected}")
+            }
+            Self::InvalidStateHome => formatter.write_str(
+                "managed state home must be a non-empty absolute path without dot segments",
+            ),
+            Self::InvalidTelemetryHome => formatter.write_str(
+                "managed telemetry home must be exactly CUA_DRIVER_STATE_HOME/telemetry",
+            ),
+            Self::InvalidStateRoot(message) => {
+                write!(formatter, "managed state root is invalid: {message}")
+            }
+        }
+    }
+}
+
+impl std::error::Error for ManagedEnvironmentError {}
+
+/// Whether Ling's managed channel is active. This is separate from the
+/// upstream `CUA_DRIVER_EMBEDDED` bit so embedding examples remain compatible.
+pub fn is_managed() -> bool {
+    std::env::var_os(LING_MANAGED_ENV).as_deref() == Some(OsStr::new("1"))
+}
+
+/// Parse and validate the complete managed environment. `Ok(None)` is the
+/// normal result for standalone/external mode.
+pub fn managed_environment() -> Result<Option<ManagedEnvironment>, ManagedEnvironmentError> {
+    if !is_managed() {
+        return Ok(None);
+    }
+    if !crate::embedded_mode() {
+        return Err(ManagedEnvironmentError::InvalidBoolean {
+            name: "CUA_DRIVER_EMBEDDED",
+            expected: "1",
+        });
+    }
+    let state_home = required_path(STATE_HOME_ENV)?;
+    exact_bool(TELEMETRY_ENABLED_ENV, false)?;
+    exact_bool(UPDATE_CHECK_ENV, false)?;
+    let expected_telemetry_home = state_home.join("telemetry");
+    let telemetry_home = match std::env::var_os(TELEMETRY_HOME_ENV) {
+        Some(value) => PathBuf::from(value),
+        None => expected_telemetry_home.clone(),
+    };
+    if telemetry_home != expected_telemetry_home {
+        return Err(ManagedEnvironmentError::InvalidTelemetryHome);
+    }
+    Ok(Some(ManagedEnvironment {
+        state_home,
+        telemetry_home,
+    }))
+}
+
+/// Validate the Desktop-created root and create the fixed initial child
+/// directories before MCP initialize can be accepted. On Unix this traverses
+/// every component with `openat(O_NOFOLLOW)` and requires 0700/current-uid.
+/// Windows uses retained handles, rejects every reparse component, and
+/// requires a protected current-token-only FullControl DACL.
+pub fn validate_state_root() -> Result<(), ManagedEnvironmentError> {
+    let Some(environment) = managed_environment()? else {
+        return Ok(());
+    };
+    platform::validate_root(&environment.state_home)
+        .map_err(ManagedEnvironmentError::InvalidStateRoot)?;
+    for relative in INITIAL_DIRECTORIES {
+        platform::ensure_directory(&environment.state_home, relative_path(relative)?)
+            .map_err(ManagedEnvironmentError::InvalidStateRoot)?;
+    }
+    Ok(())
+}
+
+/// Return Ling's isolated state root when managed mode is active. This is a
+/// diagnostic/path-display helper only; state I/O must use the capability-root
+/// helpers below.
+pub fn state_home() -> Option<PathBuf> {
+    is_managed()
+        .then(|| std::env::var_os(STATE_HOME_ENV).map(PathBuf::from))
+        .flatten()
+}
+
+/// Resolve a relative state path for display or APIs that still require a path.
+/// Traversal, dot segments, and absolute paths are rejected. Managed writers
+/// must not use the returned path directly.
+pub fn state_path(relative: impl AsRef<Path>) -> Option<PathBuf> {
+    let components = relative_components(relative.as_ref()).ok()?;
+    let mut path = state_home()?;
+    for component in components {
+        path.push(component);
+    }
+    Some(path)
+}
+
+/// Read one regular 0600/current-user file without following any link.
+pub fn read_state(relative: impl AsRef<Path>) -> Result<Option<Vec<u8>>, String> {
+    let root = managed_root()?;
+    let relative = relative_components(relative.as_ref())?;
+    platform::read_file(&root, relative)
+}
+
+/// Atomically replace one managed file. Parent directories are created with
+/// the platform's exact private-directory contract and the file is 0600 on
+/// Unix or protected/current-user-only FullControl on Windows.
+pub fn write_state_atomic(relative: impl AsRef<Path>, bytes: &[u8]) -> Result<(), String> {
+    let _guard = state_lock()?;
+    let root = managed_root()?;
+    let relative = relative_components(relative.as_ref())?;
+    platform::write_file_atomic(&root, relative, bytes)
+}
+
+/// Atomically read-modify-write one JSON object key. This is the only managed
+/// config merge primitive so concurrent MCP calls cannot lose sibling keys.
+pub fn update_json_key_atomic(
+    relative: impl AsRef<Path>,
+    key: &str,
+    value: Value,
+) -> Result<(), String> {
+    update_json_keys_atomic(relative, &[(key.to_owned(), value)])
+}
+
+/// Atomically merge a validated set of JSON object entries in one replacement.
+pub fn update_json_keys_atomic(
+    relative: impl AsRef<Path>,
+    entries: &[(String, Value)],
+) -> Result<(), String> {
+    let transaction = begin_state_transaction()?;
+    transaction.update_json_keys_atomic(relative, entries)
+}
+
+pub fn begin_state_transaction() -> Result<ManagedStateTransaction, String> {
+    let guard = state_lock()?;
+    let root = managed_root()?;
+    Ok(ManagedStateTransaction {
+        _guard: guard,
+        root,
+    })
+}
+
+fn update_json_keys_unlocked(
+    root: &Path,
+    relative: &Path,
+    entries: &[(String, Value)],
+) -> Result<(), String> {
+    if entries.is_empty() {
+        return Ok(());
+    }
+    if entries.iter().any(|(key, _)| key.is_empty()) {
+        return Err("managed JSON key is empty".to_owned());
+    }
+    let relative = relative_components(relative)?;
+    let mut json = match platform::read_file(root, relative.clone())? {
+        Some(bytes) => serde_json::from_slice::<Value>(&bytes)
+            .map_err(|error| format!("managed JSON is malformed: {error}"))?,
+        None => serde_json::json!({}),
+    };
+    let object = json
+        .as_object_mut()
+        .ok_or_else(|| "managed JSON root must be an object".to_owned())?;
+    for (key, value) in entries {
+        object.insert(key.clone(), value.clone());
+    }
+    let bytes = serde_json::to_vec_pretty(&json)
+        .map_err(|error| format!("failed to encode managed JSON: {error}"))?;
+    platform::write_file_atomic(root, relative, &bytes)
+}
+
+/// Remove one managed regular file without following a leaf link.
+pub fn remove_state_file(relative: impl AsRef<Path>) -> Result<(), String> {
+    let _guard = state_lock()?;
+    let root = managed_root()?;
+    let relative = relative_components(relative.as_ref())?;
+    platform::remove_file(&root, relative)
+}
+
+/// Return a relative capability path for an absolute path that must be under
+/// the configured root. Useful for legacy PID APIs that still carry strings.
+pub fn relative_from_state_path(path: impl AsRef<Path>) -> Result<Vec<OsString>, String> {
+    let root = managed_root()?;
+    let suffix = path
+        .as_ref()
+        .strip_prefix(&root)
+        .map_err(|_| "path is outside managed state root".to_owned())?;
+    relative_components(suffix)
+}
+
+pub fn write_state_path_atomic(path: impl AsRef<Path>, bytes: &[u8]) -> Result<(), String> {
+    let _guard = state_lock()?;
+    let root = managed_root()?;
+    let relative = relative_from_root(&root, path.as_ref())?;
+    platform::write_file_atomic(&root, relative, bytes)
+}
+
+pub fn remove_state_path_file(path: impl AsRef<Path>) -> Result<(), String> {
+    let _guard = state_lock()?;
+    let root = managed_root()?;
+    let relative = relative_from_root(&root, path.as_ref())?;
+    platform::remove_file(&root, relative)
+}
+
+pub fn prepare_state_socket_path(path: impl AsRef<Path>) -> Result<(), String> {
+    let root = managed_root()?;
+    let relative = relative_from_root(&root, path.as_ref())?;
+    platform::prepare_socket(&root, relative)
+}
+
+pub fn remove_state_socket_path(path: impl AsRef<Path>) -> Result<(), String> {
+    let root = managed_root()?;
+    let relative = relative_from_root(&root, path.as_ref())?;
+    platform::remove_socket(&root, relative)
+}
+
+/// Native acceptance-only helper. Production Desktop owns root creation; test
+/// binaries need a deterministic way to create the same platform permissions
+/// before launching the real provider.
+#[cfg(debug_assertions)]
+#[doc(hidden)]
+pub fn prepare_acceptance_state_root(path: impl AsRef<Path>) -> Result<(), String> {
+    platform::prepare_acceptance_root(path.as_ref())
+}
+
+fn managed_root() -> Result<PathBuf, String> {
+    let environment = managed_environment()
+        .map_err(|error| error.to_string())?
+        .ok_or_else(|| "managed state API used outside Ling-managed mode".to_owned())?;
+    platform::validate_root(&environment.state_home)?;
+    Ok(environment.state_home)
+}
+
+fn relative_from_root(root: &Path, path: &Path) -> Result<Vec<OsString>, String> {
+    let suffix = path
+        .strip_prefix(root)
+        .map_err(|_| "path is outside managed state root".to_owned())?;
+    relative_components(suffix)
+}
+
+fn state_lock() -> Result<std::sync::MutexGuard<'static, ()>, String> {
+    STATE_RMW_LOCK
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "managed state lock is poisoned".to_owned())
+}
+
+fn required_path(name: &'static str) -> Result<PathBuf, ManagedEnvironmentError> {
+    let value = std::env::var_os(name).ok_or(ManagedEnvironmentError::Missing(name))?;
+    let path = PathBuf::from(value);
+    if !path.is_absolute() || relative_components_for_absolute(&path).is_err() {
+        return Err(ManagedEnvironmentError::InvalidStateHome);
+    }
+    Ok(path)
+}
+
+fn exact_bool(name: &'static str, expected: bool) -> Result<(), ManagedEnvironmentError> {
+    let value = std::env::var(name).map_err(|_| ManagedEnvironmentError::Missing(name))?;
+    let expected_value = if expected { "true" } else { "false" };
+    if value != expected_value {
+        return Err(ManagedEnvironmentError::InvalidBoolean {
+            name,
+            expected: expected_value,
+        });
+    }
+    Ok(())
+}
+
+fn relative_components(path: &Path) -> Result<Vec<OsString>, String> {
+    if path.as_os_str().is_empty() || path.is_absolute() {
+        return Err("managed state path must be non-empty and relative".to_owned());
+    }
+    let mut result = Vec::new();
+    for component in path.components() {
+        match component {
+            Component::Normal(value) if !value.is_empty() => result.push(value.to_owned()),
+            _ => return Err("managed state path contains a forbidden component".to_owned()),
+        }
+    }
+    if result.is_empty() {
+        return Err("managed state path is empty".to_owned());
+    }
+    Ok(result)
+}
+
+fn relative_components_for_absolute(path: &Path) -> Result<Vec<OsString>, String> {
+    let mut result = Vec::new();
+    for component in path.components() {
+        match component {
+            Component::Prefix(_) | Component::RootDir => {}
+            Component::Normal(value) if !value.is_empty() => result.push(value.to_owned()),
+            _ => return Err("absolute state root contains a forbidden component".to_owned()),
+        }
+    }
+    if result.is_empty() {
+        return Err("managed state root cannot be a filesystem root".to_owned());
+    }
+    Ok(result)
+}
+
+fn relative_path(value: &str) -> Result<Vec<OsString>, ManagedEnvironmentError> {
+    relative_components(Path::new(value)).map_err(ManagedEnvironmentError::InvalidStateRoot)
+}
+
+#[cfg(any(target_os = "macos", target_os = "linux"))]
+mod platform {
+    use super::relative_components_for_absolute;
+    use std::ffi::{CString, OsString};
+    use std::fs::File;
+    use std::io::{Read, Write};
+    use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::{FileTypeExt, MetadataExt};
+    use std::path::{Path, PathBuf};
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    const O_RDONLY: i32 = 0;
+    const O_WRONLY: i32 = 1;
+    #[cfg(target_os = "macos")]
+    const O_CREAT: i32 = 0x0200;
+    #[cfg(target_os = "linux")]
+    const O_CREAT: i32 = 0x0040;
+    #[cfg(target_os = "macos")]
+    const O_EXCL: i32 = 0x0800;
+    #[cfg(target_os = "linux")]
+    const O_EXCL: i32 = 0x0080;
+    #[cfg(target_os = "macos")]
+    const O_NOFOLLOW: i32 = 0x0100;
+    #[cfg(target_os = "linux")]
+    const O_NOFOLLOW: i32 = 0x20000;
+    #[cfg(target_os = "macos")]
+    const O_DIRECTORY: i32 = 0x100000;
+    #[cfg(target_os = "linux")]
+    const O_DIRECTORY: i32 = 0x10000;
+    #[cfg(target_os = "macos")]
+    const O_CLOEXEC: i32 = 0x1000000;
+    #[cfg(target_os = "linux")]
+    const O_CLOEXEC: i32 = 0x80000;
+
+    static TEMP_SEQUENCE: AtomicU64 = AtomicU64::new(1);
+
+    unsafe extern "C" {
+        fn openat(directory: i32, path: *const i8, flags: i32, ...) -> i32;
+        fn mkdirat(directory: i32, path: *const i8, mode: u32) -> i32;
+        fn renameat(
+            old_directory: i32,
+            old_path: *const i8,
+            new_directory: i32,
+            new_path: *const i8,
+        ) -> i32;
+        fn unlinkat(directory: i32, path: *const i8, flags: i32) -> i32;
+        fn fsync(descriptor: i32) -> i32;
+        fn geteuid() -> u32;
+    }
+
+    pub fn validate_root(root: &Path) -> Result<(), String> {
+        let descriptor = open_root(root)?;
+        validate_directory(&descriptor, "state root")
+    }
+
+    pub fn prepare_acceptance_root(root: &Path) -> Result<(), String> {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::create_dir(root)
+            .map_err(|error| format!("failed to create acceptance state root: {error}"))?;
+        std::fs::set_permissions(root, std::fs::Permissions::from_mode(0o700))
+            .map_err(|error| format!("failed to chmod acceptance state root: {error}"))?;
+        validate_root(root)
+    }
+
+    pub fn ensure_directory(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        let _ = open_directories(root, &relative, true)?;
+        Ok(())
+    }
+
+    pub fn read_file(root: &Path, relative: Vec<OsString>) -> Result<Option<Vec<u8>>, String> {
+        let (parent, leaf) = open_parent(root, &relative, false)?;
+        let leaf = c_string(&leaf)?;
+        let raw = unsafe {
+            openat(
+                parent.as_raw_fd(),
+                leaf.as_ptr(),
+                O_RDONLY | O_NOFOLLOW | O_CLOEXEC,
+            )
+        };
+        if raw < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == std::io::ErrorKind::NotFound {
+                return Ok(None);
+            }
+            return Err(format!(
+                "failed to open managed file without following links: {error}"
+            ));
+        }
+        let descriptor = unsafe { OwnedFd::from_raw_fd(raw) };
+        validate_file(&descriptor, "managed file")?;
+        let mut file = File::from(descriptor);
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)
+            .map_err(|error| format!("failed to read managed file: {error}"))?;
+        Ok(Some(bytes))
+    }
+
+    pub fn write_file_atomic(
+        root: &Path,
+        relative: Vec<OsString>,
+        bytes: &[u8],
+    ) -> Result<(), String> {
+        let (parent, leaf) = open_parent(root, &relative, true)?;
+        match validate_existing_leaf(&parent, &leaf) {
+            Ok(()) => {}
+            Err(message) if message == "managed file is missing" => {}
+            Err(message) => return Err(message),
+        }
+        let temporary = OsString::from(format!(
+            ".ling-state-{}-{}.tmp",
+            std::process::id(),
+            TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        let temporary_c = c_string(&temporary)?;
+        let raw = unsafe {
+            openat(
+                parent.as_raw_fd(),
+                temporary_c.as_ptr(),
+                O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+                0o600_u32,
+            )
+        };
+        if raw < 0 {
+            return Err(format!(
+                "failed to create managed temporary file: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        let descriptor = unsafe { OwnedFd::from_raw_fd(raw) };
+        let result = (|| {
+            validate_file(&descriptor, "managed temporary file")?;
+            let mut file = File::from(descriptor);
+            file.write_all(bytes)
+                .map_err(|error| format!("failed to write managed file: {error}"))?;
+            file.sync_all()
+                .map_err(|error| format!("failed to sync managed file: {error}"))?;
+            let leaf_c = c_string(&leaf)?;
+            let renamed = unsafe {
+                renameat(
+                    parent.as_raw_fd(),
+                    temporary_c.as_ptr(),
+                    parent.as_raw_fd(),
+                    leaf_c.as_ptr(),
+                )
+            };
+            if renamed != 0 {
+                return Err(format!(
+                    "failed to atomically replace managed file: {}",
+                    std::io::Error::last_os_error()
+                ));
+            }
+            let synced = unsafe { fsync(parent.as_raw_fd()) };
+            if synced != 0 {
+                return Err(format!(
+                    "failed to sync managed directory: {}",
+                    std::io::Error::last_os_error()
+                ));
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            unsafe {
+                let _ = unlinkat(parent.as_raw_fd(), temporary_c.as_ptr(), 0);
+            }
+        }
+        result
+    }
+
+    pub fn remove_file(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        let (parent, leaf) = open_parent(root, &relative, false)?;
+        match validate_existing_leaf(&parent, &leaf) {
+            Ok(()) => {}
+            Err(message) if message == "managed file is missing" => return Ok(()),
+            Err(message) => return Err(message),
+        }
+        let leaf = c_string(&leaf)?;
+        if unsafe { unlinkat(parent.as_raw_fd(), leaf.as_ptr(), 0) } != 0 {
+            return Err(format!(
+                "failed to remove managed file: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        if unsafe { fsync(parent.as_raw_fd()) } != 0 {
+            return Err(format!(
+                "failed to sync managed directory: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn prepare_socket(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        remove_socket_impl(root, &relative, "stale managed socket")
+    }
+
+    pub fn remove_socket(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        remove_socket_impl(root, &relative, "managed socket")
+    }
+
+    fn remove_socket_impl(root: &Path, relative: &[OsString], label: &str) -> Result<(), String> {
+        let (parent, leaf) = open_parent(root, relative, false)?;
+        let mut absolute = root.to_path_buf();
+        for component in relative {
+            absolute.push(component);
+        }
+        let metadata = match std::fs::symlink_metadata(&absolute) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(error) => return Err(format!("failed to inspect {label}: {error}")),
+        };
+        if metadata.file_type().is_symlink() || !metadata.file_type().is_socket() {
+            return Err(format!("{label} leaf is not a native socket"));
+        }
+        let leaf = c_string(&leaf)?;
+        if unsafe { unlinkat(parent.as_raw_fd(), leaf.as_ptr(), 0) } != 0 {
+            return Err(format!(
+                "failed to remove {label}: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        if unsafe { fsync(parent.as_raw_fd()) } != 0 {
+            return Err(format!(
+                "failed to sync managed socket directory: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+        Ok(())
+    }
+
+    fn open_root(root: &Path) -> Result<OwnedFd, String> {
+        let components = relative_components_for_absolute(root)?;
+        let mut current: OwnedFd = File::open("/")
+            .map_err(|error| format!("failed to open filesystem root: {error}"))?
+            .into();
+        for component in components {
+            current = open_directory_at(&current, &component)?;
+        }
+        Ok(current)
+    }
+
+    fn open_parent(
+        root: &Path,
+        relative: &[OsString],
+        create: bool,
+    ) -> Result<(OwnedFd, OsString), String> {
+        let (leaf, parents) = relative
+            .split_last()
+            .ok_or_else(|| "managed state path is empty".to_owned())?;
+        Ok((open_directories(root, parents, create)?, leaf.clone()))
+    }
+
+    fn open_directories(
+        root: &Path,
+        relative: &[OsString],
+        create: bool,
+    ) -> Result<OwnedFd, String> {
+        let mut current = open_root(root)?;
+        validate_directory(&current, "state root")?;
+        for component in relative {
+            match open_directory_at(&current, component) {
+                Ok(next) => current = next,
+                Err(message) if create && message.starts_with("missing managed directory:") => {
+                    let name = c_string(component)?;
+                    let created = unsafe { mkdirat(current.as_raw_fd(), name.as_ptr(), 0o700) };
+                    if created != 0 {
+                        let error = std::io::Error::last_os_error();
+                        if error.kind() != std::io::ErrorKind::AlreadyExists {
+                            return Err(format!("failed to create managed directory: {error}"));
+                        }
+                    }
+                    current = open_directory_at(&current, component)?;
+                }
+                Err(message) => return Err(message),
+            }
+            validate_directory(&current, "managed directory")?;
+        }
+        Ok(current)
+    }
+
+    fn open_directory_at(parent: &OwnedFd, name: &OsString) -> Result<OwnedFd, String> {
+        let name = c_string(name)?;
+        let raw = unsafe {
+            openat(
+                parent.as_raw_fd(),
+                name.as_ptr(),
+                O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC,
+            )
+        };
+        if raw < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == std::io::ErrorKind::NotFound {
+                return Err(format!("missing managed directory: {error}"));
+            }
+            return Err(format!(
+                "failed to open managed directory without following links: {error}"
+            ));
+        }
+        Ok(unsafe { OwnedFd::from_raw_fd(raw) })
+    }
+
+    fn validate_existing_leaf(parent: &OwnedFd, leaf: &OsString) -> Result<(), String> {
+        let leaf = c_string(leaf)?;
+        let raw = unsafe {
+            openat(
+                parent.as_raw_fd(),
+                leaf.as_ptr(),
+                O_RDONLY | O_NOFOLLOW | O_CLOEXEC,
+            )
+        };
+        if raw < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == std::io::ErrorKind::NotFound {
+                return Err("managed file is missing".to_owned());
+            }
+            return Err(format!(
+                "managed file cannot be opened without following links: {error}"
+            ));
+        }
+        let descriptor = unsafe { OwnedFd::from_raw_fd(raw) };
+        validate_file(&descriptor, "managed file")
+    }
+
+    fn validate_directory(descriptor: &OwnedFd, label: &str) -> Result<(), String> {
+        let metadata = File::from(
+            descriptor
+                .try_clone()
+                .map_err(|error| format!("failed to clone {label} descriptor: {error}"))?,
+        )
+        .metadata()
+        .map_err(|error| format!("failed to inspect {label}: {error}"))?;
+        if !metadata.is_dir() {
+            return Err(format!("{label} is not a directory"));
+        }
+        validate_unix_owner_mode(&metadata, 0o700, label)
+    }
+
+    fn validate_file(descriptor: &OwnedFd, label: &str) -> Result<(), String> {
+        let metadata = File::from(
+            descriptor
+                .try_clone()
+                .map_err(|error| format!("failed to clone {label} descriptor: {error}"))?,
+        )
+        .metadata()
+        .map_err(|error| format!("failed to inspect {label}: {error}"))?;
+        if !metadata.is_file() {
+            return Err(format!("{label} is not a regular file"));
+        }
+        validate_unix_owner_mode(&metadata, 0o600, label)
+    }
+
+    fn validate_unix_owner_mode(
+        metadata: &std::fs::Metadata,
+        expected_mode: u32,
+        label: &str,
+    ) -> Result<(), String> {
+        let current_uid = unsafe { geteuid() };
+        if metadata.uid() != current_uid {
+            return Err(format!("{label} is not owned by the effective user"));
+        }
+        if metadata.mode() & 0o777 != expected_mode {
+            return Err(format!("{label} must have mode {expected_mode:04o}"));
+        }
+        Ok(())
+    }
+
+    fn c_string(value: &OsString) -> Result<CString, String> {
+        CString::new(value.as_bytes())
+            .map_err(|_| "managed state component contains a NUL byte".to_owned())
+    }
+
+    #[allow(dead_code)]
+    fn _assert_absolute_path_type(_: &PathBuf) {}
+}
+
+#[cfg(target_os = "windows")]
+mod platform {
+    use super::relative_components_for_absolute;
+    use std::ffi::{c_void, OsString};
+    use std::fs::File;
+    use std::io::{Read, Write};
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::io::{AsRawHandle, FromRawHandle};
