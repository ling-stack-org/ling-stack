+    match (has_session_id, has_session_dimension, has_global_updates) {
+        (true, true, true) => " (max_image_dimension session-scoped; global keys persisted)",
+        (true, true, false) => " (max_image_dimension session-scoped; persisted default unchanged)",
+        _ => "",
+    }
