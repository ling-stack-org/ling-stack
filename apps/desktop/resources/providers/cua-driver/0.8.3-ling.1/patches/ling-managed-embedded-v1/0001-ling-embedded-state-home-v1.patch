+    use windows::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+    static TEMP_SEQUENCE: AtomicU64 = AtomicU64::new(1);
+
+    pub fn validate_root(root: &Path) -> Result<(), String> {
+        validate_path_components(root)?;
+        let handle = open_path_handle_for_dacl(root)?;
+        validate_handle(&handle, true, true)
+    }
+
+    pub fn prepare_acceptance_root(root: &Path) -> Result<(), String> {
+        std::fs::create_dir(root)
+            .map_err(|error| format!("failed to create acceptance state root: {error}"))?;
+        let handle = open_path_handle_for_dacl(root)?;
+        apply_private_dacl(&handle, true)?;
+        validate_root(root)
+    }
+
+    pub fn ensure_directory(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        let mut current = root.to_path_buf();
+        validate_root(root)?;
+        for component in relative {
+            current.push(component);
+            if !path_entry_exists(&current)? {
+                match std::fs::create_dir(&current) {
+                    Ok(()) => {
+                        let created = open_path_handle_for_dacl(&current)?;
+                        apply_private_dacl(&created, true)?;
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+                        // A concurrent creator may have won the race. Re-open and
+                        // validate the resulting entry below; this also rejects a
+                        // reparse point instead of following it.
+                    }
+                    Err(error) => {
+                        return Err(format!("failed to create managed directory: {error}"));
+                    }
+                }
+            }
+            validate_path_components(&current)?;
+            let handle = open_path_handle(&current)?;
+            validate_handle(&handle, true, true)?;
+        }
+        Ok(())
+    }
+
+    pub fn read_file(root: &Path, relative: Vec<OsString>) -> Result<Option<Vec<u8>>, String> {
+        let path = joined_path(root, &relative)?;
+        let Some(parent) = path.parent() else {
+            return Err("managed file has no parent".to_owned());
+        };
+        validate_path_components(parent)?;
+        if !path_entry_exists(&path)? {
+            return Ok(None);
+        }
+        let handle = open_path_handle(&path)?;
+        validate_handle(&handle, false, true)?;
+        let mut file = handle;
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)
+            .map_err(|error| format!("failed to read managed file: {error}"))?;
+        Ok(Some(bytes))
+    }
+
+    pub fn write_file_atomic(
+        root: &Path,
+        relative: Vec<OsString>,
+        bytes: &[u8],
+    ) -> Result<(), String> {
+        let path = joined_path(root, &relative)?;
+        let parent = path
+            .parent()
+            .ok_or_else(|| "managed file has no parent".to_owned())?;
+        let parent_relative = path_relative_components(root, parent)?;
+        ensure_directory(root, parent_relative)?;
+        if path_entry_exists(&path)? {
+            let existing = open_path_handle(&path)?;
+            validate_handle(&existing, false, true)?;
+        }
+        let temporary = parent.join(format!(
+            ".ling-state-{}-{}.tmp",
+            std::process::id(),
+            TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        let result = (|| {
+            let mut file = create_private_file_handle(&temporary)?;
+            apply_private_dacl(&file, false)?;
+            file.write_all(bytes)
+                .map_err(|error| format!("failed to write managed file: {error}"))?;
+            file.sync_all()
+                .map_err(|error| format!("failed to sync managed file: {error}"))?;
+            let temp_handle = open_path_handle(&temporary)?;
+            validate_handle(&temp_handle, false, true)?;
+            drop(temp_handle);
+            atomic_replace(&temporary, &path)?;
+            let final_handle = open_path_handle(&path)?;
+            validate_handle(&final_handle, false, true)
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        result
+    }
+
+    pub fn remove_file(root: &Path, relative: Vec<OsString>) -> Result<(), String> {
+        let path = joined_path(root, &relative)?;
+        let Some(parent) = path.parent() else {
+            return Err("managed file has no parent".to_owned());
+        };
+        validate_path_components(parent)?;
+        if !path_entry_exists(&path)? {
+            return Ok(());
+        }
+        let handle = open_path_handle(&path)?;
+        validate_handle(&handle, false, true)?;
+        drop(handle);
+        std::fs::remove_file(&path)
+            .map_err(|error| format!("failed to remove managed file: {error}"))
+    }
+
+    pub fn prepare_socket(_: &Path, _: Vec<OsString>) -> Result<(), String> {
+        Err("managed socket paths are not used on Windows".to_owned())
+    }
+
+    pub fn remove_socket(_: &Path, _: Vec<OsString>) -> Result<(), String> {
+        Err("managed socket paths are not used on Windows".to_owned())
+    }
+
+    fn validate_path_components(path: &Path) -> Result<(), String> {
+        let _ = relative_components_for_absolute(path)?;
+        let mut current = PathBuf::new();
+        for component in path.components() {
+            current.push(component.as_os_str());
+            if matches!(
+                component,
+                std::path::Component::Prefix(_) | std::path::Component::RootDir
+            ) {
+                continue;
+            }
+            let handle = open_path_handle(&current)?;
+            validate_reparse_and_kind(&handle, true)?;
+        }
+        Ok(())
+    }
+
+    fn joined_path(root: &Path, relative: &[OsString]) -> Result<PathBuf, String> {
+        validate_root(root)?;
+        let mut path = root.to_path_buf();
+        for component in relative {
+            path.push(component);
+        }
+        Ok(path)
+    }
+
+    fn path_relative_components(root: &Path, path: &Path) -> Result<Vec<OsString>, String> {
+        let relative = path
+            .strip_prefix(root)
+            .map_err(|_| "managed path escaped state root".to_owned())?;
+        if relative.as_os_str().is_empty() {
+            return Ok(Vec::new());
+        }
+        let mut result = Vec::new();
+        for component in relative.components() {
+            match component {
+                std::path::Component::Normal(value) => result.push(value.to_owned()),
+                _ => return Err("managed path contains a forbidden component".to_owned()),
+            }
+        }
+        Ok(result)
+    }
+
+    /// Check whether a path entry exists without following a symlink or other
+    /// reparse point. `Path::exists()` follows links and returns `false` for a
+    /// dangling link, which would let a hostile entry reach the create/replace
+    /// path. `symlink_metadata()` lets the subsequent handle validation reject
+    /// every reparse point deterministically.
+    fn path_entry_exists(path: &Path) -> Result<bool, String> {
+        match std::fs::symlink_metadata(path) {
+            Ok(_) => Ok(true),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(false),
+            Err(error) => Err(format!("failed to inspect managed path entry: {error}")),
+        }
+    }
+
+    fn open_path_handle(path: &Path) -> Result<File, String> {
+        open_existing_path_handle(path, FILE_GENERIC_READ.0)
+    }
+
+    fn open_path_handle_for_dacl(path: &Path) -> Result<File, String> {
+        open_existing_path_handle(path, (FILE_GENERIC_READ | WRITE_DAC).0)
+    }
+
+    fn open_existing_path_handle(path: &Path, access: u32) -> Result<File, String> {
+        let wide = wide(path.as_os_str());
+        let handle = unsafe {
+            CreateFileW(
+                PCWSTR(wide.as_ptr()),
+                access,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                None,
+                OPEN_EXISTING,
+                FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS,
+                None,
+            )
+        }
+        .map_err(|error| format!("failed to open managed path by handle: {error}"))?;
+        Ok(unsafe { File::from_raw_handle(handle.0) })
+    }
+
+    fn create_private_file_handle(path: &Path) -> Result<File, String> {
+        let wide = wide(path.as_os_str());
+        let handle = unsafe {
+            CreateFileW(
+                PCWSTR(wide.as_ptr()),
+                (FILE_GENERIC_READ | FILE_GENERIC_WRITE | WRITE_DAC).0,
+                FILE_SHARE_READ | FILE_SHARE_DELETE,
+                None,
+                CREATE_NEW,
+                FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT,
+                None,
+            )
+        }
+        .map_err(|error| format!("failed to create managed temporary file by handle: {error}"))?;
+        Ok(unsafe { File::from_raw_handle(handle.0) })
+    }
+
+    fn validate_handle(file: &File, directory: bool, validate_acl: bool) -> Result<(), String> {
+        validate_reparse_and_kind(file, directory)?;
+        if validate_acl {
+            validate_private_dacl(file)?;
+        }
+        Ok(())
+    }
+
+    fn validate_reparse_and_kind(file: &File, directory: bool) -> Result<(), String> {
+        let handle = HANDLE(file.as_raw_handle());
+        let mut info = FILE_ATTRIBUTE_TAG_INFO::default();
+        unsafe {
+            GetFileInformationByHandleEx(
+                handle,
+                FileAttributeTagInfo,
+                &mut info as *mut _ as *mut c_void,
+                std::mem::size_of::<FILE_ATTRIBUTE_TAG_INFO>() as u32,
+            )
+        }
+        .map_err(|error| format!("failed to inspect managed path handle: {error}"))?;
+        if info.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT.0 != 0 {
+            return Err("managed path is a reparse point".to_owned());
+        }
+        let is_directory = info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY.0 != 0;
+        if is_directory != directory {
+            return Err(if directory {
+                "managed path is not a directory".to_owned()
+            } else {
+                "managed path is not a regular file".to_owned()
+            });
+        }
+        Ok(())
+    }
+
+    fn validate_private_dacl(file: &File) -> Result<(), String> {
+        let handle = HANDLE(file.as_raw_handle());
+        let current_sid = current_user_sid()?;
+        let current_sid = PSID(current_sid.as_ptr() as *mut c_void);
+        let mut owner = PSID::default();
+        let mut dacl: *mut ACL = std::ptr::null_mut();
+        let mut descriptor = PSECURITY_DESCRIPTOR::default();
+        let status = unsafe {
+            GetSecurityInfo(
+                handle,
+                SE_FILE_OBJECT,
+                OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                Some(&mut owner),
+                None,
+                Some(&mut dacl),
+                None,
+                Some(&mut descriptor),
+            )
+        };
+        if status != ERROR_SUCCESS {
+            return Err(format!("failed to read managed DACL: win32 {}", status.0));
+        }
+        let result = (|| {
+            unsafe { EqualSid(owner, current_sid) }
+                .map_err(|_| "managed path owner is not the current token SID".to_owned())?;
+            let mut control = 0u16;
+            let mut revision = 0u32;
+            unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) }
+                .map_err(|error| format!("failed to inspect managed DACL control: {error}"))?;
+            if control & SE_DACL_PROTECTED.0 == 0 {
+                return Err("managed DACL is not protected".to_owned());
+            }
+            if dacl.is_null() {
+                return Err("managed DACL is missing".to_owned());
+            }
+            let mut info = ACL_SIZE_INFORMATION::default();
+            unsafe {
+                GetAclInformation(
+                    dacl,
+                    &mut info as *mut _ as *mut c_void,
+                    std::mem::size_of::<ACL_SIZE_INFORMATION>() as u32,
+                    AclSizeInformation,
+                )
+            }
+            .map_err(|error| format!("failed to inspect managed ACL: {error}"))?;
+            if info.AceCount != 1 {
+                return Err("managed DACL must contain exactly one ACE".to_owned());
+            }
+            let mut ace: *mut c_void = std::ptr::null_mut();
+            unsafe { GetAce(dacl, 0, &mut ace) }
+                .map_err(|error| format!("failed to read managed ACE: {error}"))?;
+            let ace = unsafe { &*(ace as *const ACCESS_ALLOWED_ACE) };
+            if ace.Header.AceType != 0 {
+                return Err("managed DACL ACE is not an explicit Allow rule".to_owned());
+            }
+            if ace.Header.AceFlags & 0x10 != 0 {
+                return Err("managed DACL ACE must not be inherited".to_owned());
+            }
+            if ace.Mask & FILE_ALL_ACCESS.0 != FILE_ALL_ACCESS.0 {
+                return Err("managed DACL Allow rule is not FullControl".to_owned());
+            }
+            let ace_sid = PSID((&ace.SidStart as *const u32).cast_mut().cast());
+            unsafe { EqualSid(ace_sid, current_sid) }
+                .map_err(|_| "managed DACL grants a SID other than the current user".to_owned())
+        })();
+        unsafe {
+            let _ = LocalFree(HLOCAL(descriptor.0));
+        }
+        result
+    }
+
+    fn apply_private_dacl(file: &File, directory: bool) -> Result<(), String> {
+        let sid = current_user_sid()?;
+        let sid = PSID(sid.as_ptr() as *mut c_void);
+        let mut sid_string = PWSTR::null();
+        unsafe { ConvertSidToStringSidW(sid, &mut sid_string) }
+            .map_err(|error| format!("failed to render current user SID: {error}"))?;
+        let sid_value = unsafe { pwstr_to_string(sid_string) };
+        unsafe {
+            let _ = LocalFree(HLOCAL(sid_string.0 as *mut c_void));
+        }
+        let inheritance = if directory { "OICI" } else { "" };
+        let sddl = format!("D:P(A;{inheritance};FA;;;{sid_value})");
+        let sddl_wide = wide(OsString::from(sddl).as_os_str());
+        let mut descriptor = PSECURITY_DESCRIPTOR::default();
+        unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                PCWSTR(sddl_wide.as_ptr()),
+                1,
+                &mut descriptor,
+                None,
+            )
+        }
+        .map_err(|error| format!("failed to build private DACL: {error}"))?;
+        let result = (|| {
+            let mut present = windows::Win32::Foundation::BOOL::default();
+            let mut defaulted = windows::Win32::Foundation::BOOL::default();
+            let mut dacl: *mut ACL = std::ptr::null_mut();
+            unsafe {
+                GetSecurityDescriptorDacl(descriptor, &mut present, &mut dacl, &mut defaulted)
+            }
+            .map_err(|error| format!("failed to extract private DACL: {error}"))?;
+            if !present.as_bool() || dacl.is_null() {
+                return Err("private DACL builder returned no DACL".to_owned());
+            }
+            let status = unsafe {
+                SetSecurityInfo(
+                    HANDLE(file.as_raw_handle()),
+                    SE_FILE_OBJECT,
+                    DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                    None,
+                    None,
+                    Some(dacl),
+                    None,
+                )
+            };
+            if status != ERROR_SUCCESS {
+                return Err(format!("failed to apply private DACL: win32 {}", status.0));
+            }
+            Ok(())
+        })();
+        unsafe {
+            let _ = LocalFree(HLOCAL(descriptor.0));
+        }
+        result
+    }
+
+    fn current_user_sid() -> Result<Vec<u8>, String> {
+        let mut token = HANDLE::default();
+        unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) }
+            .map_err(|error| format!("failed to open current process token: {error}"))?;
+        let result = (|| {
+            let mut needed = 0u32;
+            let _ = unsafe { GetTokenInformation(token, TokenUser, None, 0, &mut needed) };
+            if needed == 0 {
+                return Err("current token user SID size is unavailable".to_owned());
+            }
+            let mut buffer = vec![0u8; needed as usize];
+            unsafe {
+                GetTokenInformation(
+                    token,
+                    TokenUser,
+                    Some(buffer.as_mut_ptr() as *mut c_void),
+                    needed,
+                    &mut needed,
+                )
+            }
+            .map_err(|error| format!("failed to read current token user SID: {error}"))?;
+            let token_user = unsafe { &*(buffer.as_ptr() as *const TOKEN_USER) };
+            let sid = token_user.User.Sid;
+            let length = unsafe { windows::Win32::Security::GetLengthSid(sid) } as usize;
+            let mut owned = vec![0u8; length];
+            unsafe {
+                std::ptr::copy_nonoverlapping(sid.0 as *const u8, owned.as_mut_ptr(), length);
+            }
+            Ok(owned)
+        })();
+        unsafe {
+            let _ = CloseHandle(token);
+        }
+        result
+    }
+
+    fn atomic_replace(temporary: &Path, destination: &Path) -> Result<(), String> {
+        let temporary_wide = wide(temporary.as_os_str());
+        let destination_wide = wide(destination.as_os_str());
+        if path_entry_exists(destination)? {
+            unsafe {
+                ReplaceFileW(
+                    PCWSTR(destination_wide.as_ptr()),
+                    PCWSTR(temporary_wide.as_ptr()),
+                    PCWSTR::null(),
+                    REPLACEFILE_WRITE_THROUGH,
+                    None,
+                    None,
+                )
+            }
+            .map_err(|error| format!("failed to atomically replace managed file: {error}"))
+        } else {
+            unsafe {
+                MoveFileExW(
+                    PCWSTR(temporary_wide.as_ptr()),
+                    PCWSTR(destination_wide.as_ptr()),
+                    MOVEFILE_WRITE_THROUGH,
+                )
+            }
+            .map_err(|error| format!("failed to atomically install managed file: {error}"))
+        }
+    }
+
+    fn wide(value: &std::ffi::OsStr) -> Vec<u16> {
+        value.encode_wide().chain(std::iter::once(0)).collect()
+    }
+
+    unsafe fn pwstr_to_string(value: PWSTR) -> String {
+        let mut length = 0usize;
+        while *value.0.add(length) != 0 {
+            length += 1;
+        }
+        String::from_utf16_lossy(std::slice::from_raw_parts(value.0, length))
+    }
+}
