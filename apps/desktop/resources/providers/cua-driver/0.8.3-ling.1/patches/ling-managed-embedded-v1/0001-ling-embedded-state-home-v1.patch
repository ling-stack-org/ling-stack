@@ -0,0 +1,146 @@
+//! Ling-owned managed-embedding environment and state-root contract.
+//!
+//! The functions in this module are intentionally pure path policy. Platform
+//! adapters still own native readiness and process lifetime. Standalone Cua
+//! Driver callers never enter this branch and retain their existing paths.
+
+use std::path::{Path, PathBuf};
+
+pub const LING_MANAGED_ENV: &str = "CUA_DRIVER_LING_MANAGED";
+pub const STATE_HOME_ENV: &str = "CUA_DRIVER_STATE_HOME";
+pub const TELEMETRY_ENABLED_ENV: &str = "CUA_DRIVER_RS_TELEMETRY_ENABLED";
+pub const UPDATE_CHECK_ENV: &str = "CUA_DRIVER_RS_UPDATE_CHECK";
+pub const TELEMETRY_HOME_ENV: &str = "CUA_DRIVER_TELEMETRY_HOME";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ManagedEnvironment {
+    pub state_home: PathBuf,
+    pub telemetry_home: PathBuf,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ManagedEnvironmentError {
+    Missing(&'static str),
+    InvalidBoolean {
+        name: &'static str,
+        expected: &'static str,
+    },
+    InvalidStateHome,
+}
+
+impl std::fmt::Display for ManagedEnvironmentError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Missing(name) => write!(formatter, "{name} is required in Ling-managed mode"),
+            Self::InvalidBoolean { name, expected } => {
+                write!(formatter, "{name} must be exactly {expected}")
+            }
+            Self::InvalidStateHome => formatter.write_str("managed state home must be absolute"),
+        }
+    }
+}
+
+impl std::error::Error for ManagedEnvironmentError {}
+
+/// Whether Ling's managed channel is active. This is separate from the
+/// upstream `CUA_DRIVER_EMBEDDED` bit so embedding examples remain compatible.
+pub fn is_managed() -> bool {
+    std::env::var_os(LING_MANAGED_ENV).as_deref() == Some(std::ffi::OsStr::new("1"))
+}
+
+/// Parse and validate the complete managed environment. `Ok(None)` is the
+/// normal result for standalone/external mode.
+pub fn managed_environment() -> Result<Option<ManagedEnvironment>, ManagedEnvironmentError> {
+    if !is_managed() {
+        return Ok(None);
+    }
+    if !crate::embedded_mode() {
+        return Err(ManagedEnvironmentError::InvalidBoolean {
+            name: "CUA_DRIVER_EMBEDDED",
+            expected: "1",
+        });
+    }
+    let state_home = required_path(STATE_HOME_ENV)?;
+    exact_bool(TELEMETRY_ENABLED_ENV, false)?;
+    exact_bool(UPDATE_CHECK_ENV, false)?;
+    let telemetry_home = match std::env::var_os(TELEMETRY_HOME_ENV) {
+        Some(value) => PathBuf::from(value),
+        None => state_home.join("telemetry"),
+    };
+    Ok(Some(ManagedEnvironment {
+        state_home,
+        telemetry_home,
+    }))
+}
+
+/// Return Ling's isolated state root when managed mode is active.
+pub fn state_home() -> Option<PathBuf> {
+    is_managed()
+        .then(|| std::env::var_os(STATE_HOME_ENV).map(PathBuf::from))
+        .flatten()
+}
+
+/// Resolve a relative state path under `CUA_DRIVER_STATE_HOME`.
+/// Traversal and absolute paths are rejected so a malformed host environment
+/// cannot redirect writes to the user's normal Cua Driver state.
+pub fn state_path(relative: impl AsRef<Path>) -> Option<PathBuf> {
+    let relative = relative.as_ref();
+    if relative.is_absolute()
+        || relative
+            .components()
+            .any(|component| component == std::path::Component::ParentDir)
+    {
+        return None;
+    }
+    Some(state_home()?.join(relative))
+}
+
+fn required_path(name: &'static str) -> Result<PathBuf, ManagedEnvironmentError> {
+    let value = std::env::var_os(name).ok_or(ManagedEnvironmentError::Missing(name))?;
+    let path = PathBuf::from(value);
+    if !path.is_absolute() {
+        return Err(ManagedEnvironmentError::InvalidStateHome);
+    }
+    Ok(path)
+}
+
+fn exact_bool(name: &'static str, expected: bool) -> Result<(), ManagedEnvironmentError> {
+    let value = std::env::var(name).map_err(|_| ManagedEnvironmentError::Missing(name))?;
+    let expected_value = if expected { "true" } else { "false" };
+    if value != expected_value {
+        return Err(ManagedEnvironmentError::InvalidBoolean {
+            name,
+            expected: expected_value,
+        });
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn state_path_rejects_absolute_and_parent_paths() {
+        std::env::set_var(LING_MANAGED_ENV, "1");
+        std::env::set_var(crate::EMBEDDED_ENV, "1");
+        std::env::set_var(STATE_HOME_ENV, "/tmp/ling-managed-state");
+        std::env::set_var(TELEMETRY_ENABLED_ENV, "false");
+        std::env::set_var(UPDATE_CHECK_ENV, "false");
+        assert_eq!(
+            state_path("config.json"),
+            Some(PathBuf::from("/tmp/ling-managed-state/config.json"))
+        );
+        assert_eq!(state_path("../config.json"), None);
+        assert_eq!(state_path("/tmp/other.json"), None);
+        for name in [
+            LING_MANAGED_ENV,
+            crate::EMBEDDED_ENV,
+            STATE_HOME_ENV,
+            TELEMETRY_ENABLED_ENV,
+            UPDATE_CHECK_ENV,
+        ] {
+            std::env::remove_var(name);
+        }
+    }
+}
