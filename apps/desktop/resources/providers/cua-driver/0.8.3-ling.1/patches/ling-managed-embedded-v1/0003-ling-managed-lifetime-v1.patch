+fn wait_for_exit(child: &mut Child, timeout: Duration) -> std::process::ExitStatus {
+    match child.wait_timeout(timeout).expect("wait for provider") {
+        Some(status) => status,
+        None => {
+            let _ = child.kill();
+            let status = child.wait().expect("reap timed-out provider");
+            panic!("provider did not exit within {timeout:?}; killed with {status:?}");
+        }
+    }
+}
