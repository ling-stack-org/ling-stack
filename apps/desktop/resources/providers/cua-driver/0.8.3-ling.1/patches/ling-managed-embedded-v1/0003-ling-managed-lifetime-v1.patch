+//! Ling-managed process-lifetime identity and exact host-death watcher.
+
+pub const LING_MANAGED_ENV: &str = "CUA_DRIVER_LING_MANAGED";
+pub const HOST_PID_ENV: &str = "CUA_DRIVER_HOST_PID";
+pub const CHILD_INSTANCE_NONCE_ENV: &str = "CUA_DRIVER_CHILD_INSTANCE_NONCE";
+pub const LEASE_GENERATION_ENV: &str = "CUA_DRIVER_LEASE_GENERATION";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ManagedLifetimeIdentity {
+    pub host_pid: u32,
+    pub child_instance_nonce: String,
+    pub lease_generation: u64,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum ManagedLifetimeError {
+    Missing(&'static str),
+    InvalidPositiveInteger(&'static str),
+    EmbeddedModeRequired,
+    ExactHostWatcherUnavailable,
+}
+
+impl std::fmt::Display for ManagedLifetimeError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Missing(name) => write!(formatter, "{name} is required in Ling-managed mode"),
+            Self::InvalidPositiveInteger(name) => {
+                write!(formatter, "{name} must be a positive integer")
+            }
+            Self::EmbeddedModeRequired => {
+                formatter.write_str("Ling-managed mode requires upstream embedded mode")
+            }
+            Self::ExactHostWatcherUnavailable => {
+                formatter.write_str("exact Ling host-process watcher is unavailable")
+            }
+        }
+    }
+}
+impl std::error::Error for ManagedLifetimeError {}
+
+pub fn managed_lifetime_identity() -> Result<Option<ManagedLifetimeIdentity>, ManagedLifetimeError>
+{
+    if std::env::var_os(LING_MANAGED_ENV).as_deref() != Some(std::ffi::OsStr::new("1")) {
+        return Ok(None);
+    }
+    if !cua_driver_core::embedded_mode() {
+        return Err(ManagedLifetimeError::EmbeddedModeRequired);
+    }
+    let host_pid = positive_u32(HOST_PID_ENV)?;
+    let lease_generation = positive_u64(LEASE_GENERATION_ENV)?;
+    let child_instance_nonce = required(CHILD_INSTANCE_NONCE_ENV)?;
+    if child_instance_nonce.is_empty() {
+        return Err(ManagedLifetimeError::Missing(CHILD_INSTANCE_NONCE_ENV));
+    }
+    Ok(Some(ManagedLifetimeIdentity {
+        host_pid,
+        child_instance_nonce,
+        lease_generation,
+    }))
+}
+
+fn required(name: &'static str) -> Result<String, ManagedLifetimeError> {
+    std::env::var(name).map_err(|_| ManagedLifetimeError::Missing(name))
+}
+
+fn positive_u32(name: &'static str) -> Result<u32, ManagedLifetimeError> {
+    let value = required(name)?;
+    value
+        .parse::<u32>()
+        .ok()
+        .filter(|value| *value > 0)
+        .ok_or(ManagedLifetimeError::InvalidPositiveInteger(name))
+}
+
+fn positive_u64(name: &'static str) -> Result<u64, ManagedLifetimeError> {
+    let value = required(name)?;
+    value
+        .parse::<u64>()
+        .ok()
+        .filter(|value| *value > 0)
+        .ok_or(ManagedLifetimeError::InvalidPositiveInteger(name))
+}
+
+/// Open a retained kernel identity for the exact host process before the MCP
+/// child can initialize, then wait on that identity in a dedicated thread.
+/// This cannot follow a recycled PID. The stdio loop independently returns on
+/// EOF, so either host death signal closes the managed process.
+pub fn start_host_watcher() -> Result<(), ManagedLifetimeError> {
+    let Some(identity) = managed_lifetime_identity()? else {
+        return Ok(());
+    };
+    if identity.host_pid == std::process::id() {
+        return Err(ManagedLifetimeError::InvalidPositiveInteger(HOST_PID_ENV));
+    }
+    start_exact_host_watcher(identity.host_pid)
+}
+
+#[cfg(target_os = "macos")]
+fn start_exact_host_watcher(host_pid: u32) -> Result<(), ManagedLifetimeError> {
+    let queue = register_darwin_process_exit(host_pid)?;
+    std::thread::Builder::new()
+        .name("ling-cua-host-watch".to_owned())
+        .spawn(move || {
+            let _ = wait_darwin_process_exit(queue);
+            std::process::exit(0);
+        })
+        .map(|_| ())
+        .map_err(|_| {
+            unsafe {
+                libc::close(queue);
+            }
+            ManagedLifetimeError::ExactHostWatcherUnavailable
+        })
+}
+
+#[cfg(target_os = "macos")]
+fn register_darwin_process_exit(host_pid: u32) -> Result<libc::c_int, ManagedLifetimeError> {
+    let queue = unsafe { libc::kqueue() };
+    if queue < 0 {
+        return Err(ManagedLifetimeError::ExactHostWatcherUnavailable);
+    }
+    let change = libc::kevent {
+        ident: host_pid as libc::uintptr_t,
+        filter: libc::EVFILT_PROC,
+        flags: libc::EV_ADD | libc::EV_ENABLE | libc::EV_ONESHOT,
+        fflags: libc::NOTE_EXIT,
+        data: 0,
+        udata: std::ptr::null_mut(),
+    };
+    let registered =
+        unsafe { libc::kevent(queue, &change, 1, std::ptr::null_mut(), 0, std::ptr::null()) };
+    if registered < 0 {
+        unsafe {
+            libc::close(queue);
+        }
+        return Err(ManagedLifetimeError::ExactHostWatcherUnavailable);
+    }
+    Ok(queue)
+}
+
+#[cfg(target_os = "macos")]
+fn wait_darwin_process_exit(queue: libc::c_int) -> bool {
+    let mut event: libc::kevent = unsafe { std::mem::zeroed() };
+    let observed =
+        unsafe { libc::kevent(queue, std::ptr::null(), 0, &mut event, 1, std::ptr::null()) };
+    unsafe {
+        libc::close(queue);
+    }
+    observed == 1 && event.filter == libc::EVFILT_PROC && event.fflags & libc::NOTE_EXIT != 0
+}
+
+#[cfg(target_os = "linux")]
+fn start_exact_host_watcher(host_pid: u32) -> Result<(), ManagedLifetimeError> {
+    let descriptor = unsafe { libc::syscall(libc::SYS_pidfd_open, host_pid as libc::pid_t, 0) };
+    if descriptor < 0 {
+        return Err(ManagedLifetimeError::ExactHostWatcherUnavailable);
+    }
+    let descriptor = descriptor as libc::c_int;
+    std::thread::Builder::new()
+        .name("ling-cua-host-watch".to_owned())
+        .spawn(move || {
+            let mut poll = libc::pollfd {
+                fd: descriptor,
+                events: libc::POLLIN,
+                revents: 0,
+            };
+            unsafe {
+                let _ = libc::poll(&mut poll, 1, -1);
+                libc::close(descriptor);
+            }
+            std::process::exit(0);
+        })
+        .map(|_| ())
+        .map_err(|_| {
+            unsafe {
+                libc::close(descriptor);
+            }
+            ManagedLifetimeError::ExactHostWatcherUnavailable
+        })
+}
+
+#[cfg(target_os = "windows")]
+fn start_exact_host_watcher(host_pid: u32) -> Result<(), ManagedLifetimeError> {
+    platform_windows::managed_lifetime::start_host_watcher(host_pid)
+        .map_err(|_| ManagedLifetimeError::ExactHostWatcherUnavailable)
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux", target_os = "windows")))]
+fn start_exact_host_watcher(_host_pid: u32) -> Result<(), ManagedLifetimeError> {
+    Err(ManagedLifetimeError::ExactHostWatcherUnavailable)
+}
+
+#[cfg(all(test, target_os = "macos"))]
+mod darwin_tests {
+    use super::*;
+
+    #[test]
+    fn kqueue_tracks_the_exact_child_until_exit() {
+        let mut child = std::process::Command::new("/bin/sh")
+            .args(["-c", "sleep 0.05"])
+            .spawn()
+            .unwrap();
+        let queue = register_darwin_process_exit(child.id()).unwrap();
+        assert!(wait_darwin_process_exit(queue));
+        assert!(child.wait().unwrap().success());
+    }
+}
