+//! Windows retained-process and Job Object ownership for Ling-managed mode.
+
+#[cfg(target_os = "windows")]
+use std::sync::OnceLock;
+
+#[cfg(target_os = "windows")]
+static JOB_HANDLE: OnceLock<Result<usize, String>> = OnceLock::new();
+
+/// Attach the current provider process to a private, non-inheritable Job
+/// Object. The default job policy forbids breakaway; KILL_ON_JOB_CLOSE removes
+/// every descendant when the provider process closes its retained job handle.
+#[cfg(target_os = "windows")]
+pub fn ensure_kill_on_close_job() -> Result<(), String> {
+    use windows::Win32::System::Threading::GetCurrentProcess;
+
+    let result = JOB_HANDLE.get_or_init(|| {
+        let job = create_kill_on_close_job()?;
+        if let Err(error) = assign_process_to_job(job, unsafe { GetCurrentProcess() }) {
+            close_handle(job);
+            return Err(error);
+        }
+        crate::managed_readiness::set_job_object_state(true, true);
+        Ok(job.0 as usize)
+    });
+    result.as_ref().map(|_| ()).map_err(Clone::clone)
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn ensure_kill_on_close_job() -> Result<(), String> {
+    Ok(())
+}
+
+/// Open the exact host process before returning, then retain that SYNCHRONIZE
+/// handle in the watcher thread. A recycled PID cannot satisfy the wait.
+#[cfg(target_os = "windows")]
+pub fn start_host_watcher(host_pid: u32) -> Result<(), String> {
+    let handle = open_process_for_synchronize(host_pid)?;
+    let raw = handle.0 as usize;
+    std::thread::Builder::new()
+        .name("ling-cua-host-watch".to_owned())
+        .spawn(move || {
+            let handle = windows::Win32::Foundation::HANDLE(raw as *mut _);
+            let observed = wait_for_process_handle(handle);
+            close_handle(handle);
+            std::process::exit(if observed { 0 } else { 78 });
+        })
+        .map(|_| ())
+        .map_err(|error| {
+            close_handle(handle);
+            format!("cua_windows_lifecycle_unavailable:{error}")
+        })
+}
+
+#[cfg(not(target_os = "windows"))]
+pub fn start_host_watcher(_host_pid: u32) -> Result<(), String> {
+    Err("cua_windows_lifecycle_unavailable:not Windows".to_owned())
+}
+
+#[cfg(target_os = "windows")]
+fn create_kill_on_close_job() -> Result<windows::Win32::Foundation::HANDLE, String> {
+    use std::ffi::c_void;
+    use windows::Win32::System::JobObjects::{
+        CreateJobObjectW, JobObjectExtendedLimitInformation, SetInformationJobObject,
+        JOBOBJECT_EXTENDED_LIMIT_INFORMATION, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+    };
+
+    let job = unsafe { CreateJobObjectW(None, windows::core::PCWSTR::null()) }
+        .map_err(|error| format!("cua_windows_lifecycle_unavailable:{error}"))?;
+    let mut info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
+    info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    let result = unsafe {
+        SetInformationJobObject(
+            job,
+            JobObjectExtendedLimitInformation,
+            &info as *const _ as *const c_void,
+            std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32,
+        )
+    };
+    if let Err(error) = result {
+        close_handle(job);
+        return Err(format!("cua_windows_lifecycle_unavailable:{error}"));
+    }
+    Ok(job)
+}
+
+#[cfg(target_os = "windows")]
+fn assign_process_to_job(
+    job: windows::Win32::Foundation::HANDLE,
+    process: windows::Win32::Foundation::HANDLE,
+) -> Result<(), String> {
+    use windows::Win32::System::JobObjects::AssignProcessToJobObject;
+    unsafe { AssignProcessToJobObject(job, process) }
+        .map_err(|error| format!("cua_windows_lifecycle_unavailable:{error}"))
+}
+
+#[cfg(target_os = "windows")]
+fn open_process_for_synchronize(
+    host_pid: u32,
+) -> Result<windows::Win32::Foundation::HANDLE, String> {
+    use windows::Win32::System::Threading::{OpenProcess, PROCESS_SYNCHRONIZE};
+    unsafe { OpenProcess(PROCESS_SYNCHRONIZE, false, host_pid) }
+        .map_err(|error| format!("cua_windows_lifecycle_unavailable:{error}"))
+}
+
+#[cfg(target_os = "windows")]
+fn wait_for_process_handle(handle: windows::Win32::Foundation::HANDLE) -> bool {
+    use windows::Win32::Foundation::WAIT_OBJECT_0;
+    use windows::Win32::System::Threading::WaitForSingleObject;
+    (unsafe { WaitForSingleObject(handle, u32::MAX) }) == WAIT_OBJECT_0
+}
+
+#[cfg(target_os = "windows")]
+fn close_handle(handle: windows::Win32::Foundation::HANDLE) {
+    unsafe {
+        let _ = windows::Win32::Foundation::CloseHandle(handle);
+    }
+}
+
+#[cfg(all(test, target_os = "windows"))]
+mod tests {
+    use super::*;
+    use std::os::windows::io::AsRawHandle;
+
+    #[test]
+    fn retained_handle_observes_the_exact_child_exit() {
+        let mut child = std::process::Command::new("cmd.exe")
+            .args(["/c", "ping -n 2 127.0.0.1 >nul"])
+            .spawn()
+            .unwrap();
+        let handle = open_process_for_synchronize(child.id()).unwrap();
+        assert!(wait_for_process_handle(handle));
+        close_handle(handle);
+        assert!(child.wait().unwrap().success());
+    }
+
+    #[test]
+    fn kill_on_close_job_terminates_an_assigned_descendant() {
+        let job = create_kill_on_close_job().unwrap();
+        let mut child = std::process::Command::new("cmd.exe")
+            .args(["/c", "ping -n 30 127.0.0.1 >nul"])
+            .spawn()
+            .unwrap();
+        let process = windows::Win32::Foundation::HANDLE(child.as_raw_handle());
+        assign_process_to_job(job, process).unwrap();
+        close_handle(job);
+        for _ in 0..50 {
+            if child.try_wait().unwrap().is_some() {
+                return;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(100));
+        }
+        let _ = child.kill();
+        panic!("KILL_ON_JOB_CLOSE did not terminate the assigned descendant");
+    }
+}
