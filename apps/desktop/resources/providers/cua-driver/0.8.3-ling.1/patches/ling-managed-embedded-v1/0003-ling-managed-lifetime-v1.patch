diff --git a/libs/cua-driver/rust/crates/cua-driver/tests/ling_managed_native.rs b/libs/cua-driver/rust/crates/cua-driver/tests/ling_managed_native.rs
new file mode 100644
index 0000000..430abc5
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver/tests/ling_managed_native.rs
@@ -0,0 +1,402 @@
+#![cfg(debug_assertions)]
+
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::mpsc::{self, Receiver};
+use std::time::{Duration, Instant};
+use wait_timeout::ChildExt;
+
+const PROVIDER: &str = env!("CARGO_BIN_EXE_cua-driver");
+
+struct ManagedFixture {
+    _temporary: tempfile::TempDir,
+    root: PathBuf,
+    home: PathBuf,
+}
+
+impl ManagedFixture {
+    fn new() -> Self {
+        let temporary = tempfile::tempdir().expect("temporary fixture");
+        let canonical = fs::canonicalize(temporary.path()).expect("canonical fixture root");
+        let root = canonical.join("state");
+        let home = canonical.join("external-home");
+        fs::create_dir(&home).expect("external home");
+        cua_driver_core::ling_managed::prepare_acceptance_state_root(&root)
+            .expect("private managed root");
+        Self {
+            _temporary: temporary,
+            root,
+            home,
+        }
+    }
+
+    fn seed_external_sentinels(&self) -> BTreeMap<PathBuf, Vec<u8>> {
+        let standalone = self.home.join(".cua-driver");
+        let rust_state = self.home.join(".cua-driver-rs");
+        fs::create_dir_all(&standalone).unwrap();
+        fs::create_dir_all(&rust_state).unwrap();
+        fs::write(
+            standalone.join("config.json"),
+            b"external-config-sentinel\0\xff",
+        )
+        .unwrap();
+        fs::write(
+            rust_state.join("version_check.json"),
+            b"external-version-sentinel\r\n",
+        )
+        .unwrap();
+        snapshot_tree(&self.home)
+    }
+}
+
+struct McpProcess {
+    child: Child,
+    stdin: Option<ChildStdin>,
+    responses: Receiver<Value>,
+}
+
+impl McpProcess {
+    fn spawn(fixture: &ManagedFixture, host_pid: u32, extra: &[(&str, PathBuf)]) -> Self {
+        let mut command = managed_command(fixture, host_pid);
+        for (name, value) in extra {
+            command.env(name, value);
+        }
+        command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+        let mut child = command.spawn().expect("spawn managed provider");
+        let stdin = child.stdin.take().expect("provider stdin");
+        let stdout = child.stdout.take().expect("provider stdout");
+        let stderr = child.stderr.take().expect("provider stderr");
+        let (sender, responses) = mpsc::channel();
+        std::thread::spawn(move || {
+            for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+                if let Ok(value) = serde_json::from_str::<Value>(&line) {
+                    let _ = sender.send(value);
+                }
+            }
+        });
+        std::thread::spawn(move || {
+            for line in BufReader::new(stderr).lines().map_while(Result::ok) {
+                eprintln!("managed provider: {line}");
+            }
+        });
+        Self {
+            child,
+            stdin: Some(stdin),
+            responses,
+        }
+    }
+
+    fn request(&mut self, id: u64, method: &str, params: Value) -> Value {
+        let request = json!({
+            "jsonrpc": "2.0",
+            "id": id,
+            "method": method,
+            "params": params,
+        });
+        let stdin = self.stdin.as_mut().expect("provider stdin open");
+        writeln!(stdin, "{request}").expect("write MCP request");
+        stdin.flush().expect("flush MCP request");
+        let deadline = Instant::now() + Duration::from_secs(15);
+        loop {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            let value = self
+                .responses
+                .recv_timeout(remaining)
+                .expect("provider response timed out");
+            if value.get("id").and_then(Value::as_u64) == Some(id) {
+                return value;
+            }
+        }
+    }
+
+    fn initialize(&mut self) -> Value {
+        self.request(
+            1,
+            "initialize",
+            json!({
+                "protocolVersion": "2025-11-25",
+                "capabilities": {},
+                "clientInfo": {"name": "ling-native-acceptance", "version": "1"}
+            }),
+        )
+    }
+
+    fn close_stdin_and_wait(&mut self) -> std::process::ExitStatus {
+        drop(self.stdin.take());
+        wait_for_exit(&mut self.child, Duration::from_secs(10))
+    }
+}
+
+impl Drop for McpProcess {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+#[test]
+fn managed_state_survives_restart_without_touching_external_home() {
+    let fixture = ManagedFixture::new();
+    let external_before = fixture.seed_external_sentinels();
+
+    let mut first = McpProcess::spawn(&fixture, std::process::id(), &[]);
+    let initialize = first.initialize();
+    assert_eq!(
+        initialize.pointer("/result/protocolVersion"),
+        Some(&json!("2025-06-18"))
+    );
+    let updated = first.request(
+        2,
+        "tools/call",
+        json!({
+            "name": "set_config",
+            "arguments": {
+                "capture_scope": "desktop",
+                "max_image_dimension": 900,
+                "experimental_pip": false
+            }
+        }),
+    );
+    assert_ne!(updated.pointer("/result/isError"), Some(&Value::Bool(true)));
+    assert!(first.close_stdin_and_wait().success());
+
+    assert_eq!(snapshot_tree(&fixture.home), external_before);
+    let config: Value = serde_json::from_slice(
+        &fs::read(fixture.root.join("config.json")).expect("managed config"),
+    )
+    .unwrap();
+    assert_eq!(config["capture_scope"], "desktop");
+    assert_eq!(config["max_image_dimension"], 900);
+
+    let mut second = McpProcess::spawn(&fixture, std::process::id(), &[]);
+    second.initialize();
+    let config = second.request(
+        2,
+        "tools/call",
+        json!({"name": "get_config", "arguments": {}}),
+    );
+    assert_eq!(
+        config.pointer("/result/structuredContent/capture_scope"),
+        Some(&json!("desktop"))
+    );
+    assert_eq!(
+        config.pointer("/result/structuredContent/max_image_dimension"),
+        Some(&json!(900))
+    );
+    let health = second.request(
+        3,
+        "tools/call",
+        json!({"name": "health_report", "arguments": {}}),
+    );
+    assert!(health.pointer("/result/structuredContent").is_some());
+    assert!(second.close_stdin_and_wait().success());
+    assert_eq!(snapshot_tree(&fixture.home), external_before);
+}
+
+#[test]
+fn standalone_ignores_managed_state_variable_and_keeps_upstream_home_semantics() {
+    let fixture = ManagedFixture::new();
+    let state_before = snapshot_tree(&fixture.root);
+    let status = Command::new(PROVIDER)
+        .args(["config", "set", "capture_scope", "desktop"])
+        .env("HOME", &fixture.home)
+        .env("USERPROFILE", &fixture.home)
