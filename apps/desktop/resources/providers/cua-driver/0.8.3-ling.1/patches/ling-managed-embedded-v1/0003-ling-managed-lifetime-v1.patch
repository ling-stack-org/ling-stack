+fn snapshot_tree(root: &Path) -> BTreeMap<PathBuf, Vec<u8>> {
+    fn visit(base: &Path, current: &Path, result: &mut BTreeMap<PathBuf, Vec<u8>>) {
+        let mut entries: Vec<_> = fs::read_dir(current)
+            .unwrap()
+            .map(|entry| entry.unwrap())
+            .collect();
+        entries.sort_by_key(|entry| entry.file_name());
+        for entry in entries {
+            let path = entry.path();
+            let relative = path.strip_prefix(base).unwrap().to_path_buf();
+            let metadata = fs::symlink_metadata(&path).unwrap();
+            if metadata.is_dir() {
+                result.insert(relative.clone(), b"<directory>".to_vec());
+                visit(base, &path, result);
+            } else if metadata.is_file() {
+                result.insert(relative, fs::read(path).unwrap());
+            } else {
+                result.insert(relative, b"<non-regular>".to_vec());
+            }
+        }
+    }
+    let mut result = BTreeMap::new();
+    visit(root, root, &mut result);
+    result
+}
