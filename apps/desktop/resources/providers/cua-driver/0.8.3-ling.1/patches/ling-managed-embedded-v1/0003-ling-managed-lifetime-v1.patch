+#[cfg(target_os = "windows")]
+#[test]
+fn provider_job_kills_a_provider_created_grandchild() {
+    use windows::Win32::Foundation::{CloseHandle, WAIT_OBJECT_0};
+    use windows::Win32::System::Threading::{
+        OpenProcess, WaitForSingleObject, PROCESS_SYNCHRONIZE,
+    };
+
+    let fixture = ManagedFixture::new();
+    let pid_file = fixture.root.join("run/native-grandchild.pid");
+    let helper_pid_file = pid_file.with_extension("helper.pid");
+    let mut provider = McpProcess::spawn(
+        &fixture,
+        std::process::id(),
+        &[(
+            "CUA_DRIVER_LING_NATIVE_ACCEPTANCE_GRANDCHILD_PID_FILE",
+            pid_file.clone(),
+        )],
+    );
+    provider.initialize();
+    let deadline = Instant::now() + Duration::from_secs(15);
+    let read_pid = |path: &Path| {
+        fs::read_to_string(path)
+            .ok()
+            .and_then(|value| value.trim().parse::<u32>().ok())
+    };
+    let (helper_pid, grandchild_pid) = loop {
+        if let (Some(helper), Some(grandchild)) = (read_pid(&helper_pid_file), read_pid(&pid_file))
+        {
+            break (helper, grandchild);
+        }
+        assert!(
+            Instant::now() < deadline,
+            "helper/grandchild PIDs were not both published"
+        );
+        std::thread::sleep(Duration::from_millis(50));
+    };
+    let helper_handle = unsafe { OpenProcess(PROCESS_SYNCHRONIZE, false, helper_pid) }
+        .expect("open provider-created helper");
+    let grandchild_handle = unsafe { OpenProcess(PROCESS_SYNCHRONIZE, false, grandchild_pid) }
+        .expect("open provider-created grandchild");
+    assert!(provider.close_stdin_and_wait().success());
+    let helper_wait = unsafe { WaitForSingleObject(helper_handle, 10_000) };
+    let grandchild_wait = unsafe { WaitForSingleObject(grandchild_handle, 10_000) };
+    unsafe {
+        let _ = CloseHandle(helper_handle);
+        let _ = CloseHandle(grandchild_handle);
+    }
+    assert_eq!(
+        helper_wait, WAIT_OBJECT_0,
+        "provider Job left its helper alive"
+    );
+    assert_eq!(
+        grandchild_wait, WAIT_OBJECT_0,
+        "provider Job left its grandchild alive"
+    );
+}
