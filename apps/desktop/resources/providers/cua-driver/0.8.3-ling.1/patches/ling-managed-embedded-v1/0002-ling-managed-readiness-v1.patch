+//! Generation-fenced, content-free readiness control for Ling's embedded child.
+//!
+//! The wire structs intentionally mirror the public Desktop contract.  The
+//! `deny_unknown_fields` request boundary prevents a future caller from
+//! smuggling arbitrary MCP metadata into this private control namespace.
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+pub const METHOD: &str = "ling/managed_readiness";
+pub const NOTIFICATION: &str = "ling/managed_readiness_changed";
+pub const SCHEMA_VERSION: u8 = 1;
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum ProcessIntegrityLevel {
+    Medium,
+    High,
+    System,
+    Unknown,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum InputDesktopState {
+    DefaultUnlocked,
+    Locked,
+    NonDefault,
+    Unavailable,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum RuntimeAvailability {
+    Available,
+    Unavailable,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum WgcApiSupport {
+    Supported,
+    Unsupported,
+    Unavailable,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ManagedReadinessRequestV1 {
+    pub schema_version: u8,
+    pub child_instance_nonce: String,
+    pub lease_generation: u64,
+}
+
+impl ManagedReadinessRequestV1 {
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.schema_version != SCHEMA_VERSION {
+            return Err("unsupported readiness schema");
+        }
+        if self.child_instance_nonce.is_empty() {
+            return Err("readiness nonce is empty");
+        }
+        if self.lease_generation == 0 {
+            return Err("readiness generation is zero");
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ManagedReadinessV1 {
+    pub schema_version: u8,
+    pub child_instance_nonce: String,
+    pub lease_generation: u64,
+    pub readiness_sequence: u64,
+    pub host_process_id: u32,
+    pub host_session_id: u32,
+    pub host_integrity_level: ProcessIntegrityLevel,
+    pub provider_process_id: u32,
+    pub provider_session_id: u32,
+    pub provider_integrity_level: ProcessIntegrityLevel,
+    pub input_desktop: InputDesktopState,
+    pub job_object_assigned: bool,
+    pub kill_on_job_close: bool,
+    pub uia_runtime: RuntimeAvailability,
+    pub d3d11: RuntimeAvailability,
+    pub wgc_api: WgcApiSupport,
+    pub content_observed: bool,
+}
+
+impl ManagedReadinessV1 {
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.schema_version != SCHEMA_VERSION {
+            return Err("unsupported readiness schema");
+        }
+        if self.child_instance_nonce.is_empty() {
+            return Err("readiness nonce is empty");
+        }
+        if self.lease_generation == 0 || self.readiness_sequence == 0 {
+            return Err("readiness generation or sequence is zero");
+        }
+        if self.host_process_id == 0 || self.provider_process_id == 0 {
+            return Err("readiness process id is zero");
+        }
+        if self.content_observed {
+            return Err("readiness content flag must remain false");
+        }
+        Ok(())
+    }
+
+    pub fn is_current_for(&self, request: &ManagedReadinessRequestV1) -> bool {
+        self.validate().is_ok()
+            && request.validate().is_ok()
+            && self.child_instance_nonce == request.child_instance_nonce
+            && self.lease_generation == request.lease_generation
+    }
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum ReadinessChangeReason {
+    Lock,
+    Unlock,
+    Disconnect,
+    Logoff,
+    FastUserSwitch,
+    SessionMismatch,
+    InputDesktopChanged,
+    Heartbeat,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ManagedReadinessChangedV1 {
+    #[serde(flatten)]
+    pub snapshot: ManagedReadinessV1,
+    pub reason: ReadinessChangeReason,
+}
+
+pub trait Provider: Send + Sync + 'static {
+    fn snapshot(&self, request: &ManagedReadinessRequestV1) -> Result<ManagedReadinessV1, String>;
+}
+
+static PROVIDER: OnceLock<Arc<dyn Provider>> = OnceLock::new();
+static ACTIVE_REQUEST: OnceLock<Mutex<Option<ManagedReadinessRequestV1>>> = OnceLock::new();
+static LAST_SNAPSHOT: OnceLock<Mutex<Option<ManagedReadinessV1>>> = OnceLock::new();
+static NEXT_SEQUENCE: AtomicU64 = AtomicU64::new(1);
+
+pub fn set_provider(provider: Arc<dyn Provider>) -> bool {
+    PROVIDER.set(provider).is_ok()
+}
+
+pub fn snapshot(params: Option<&Value>) -> Result<Value, String> {
+    let request = parse_request(params)?;
+    let value = snapshot_for_request(&request)?;
+    *active_request()
+        .lock()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())? = Some(request);
+    *last_snapshot()
+        .lock()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())? = Some(value.clone());
+    serde_json::to_value(value).map_err(|_| "cua_windows_platform_unavailable".to_owned())
+}
+
+/// Produce one private notification for the active request.  The caller owns
+/// transport framing; no notification is emitted before a valid readiness
+/// request establishes the nonce/generation fence.
+pub fn heartbeat_notification() -> Result<Option<Value>, String> {
+    let request = active_request()
+        .lock()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())?
+        .clone();
+    let Some(request) = request else {
+        return Ok(None);
+    };
+    let current = snapshot_for_request(&request)?;
+    let previous = last_snapshot()
+        .lock()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())?
+        .clone();
+    let reason = previous
+        .as_ref()
+        .map(|old| change_reason(old, &current))
+        .unwrap_or(ReadinessChangeReason::Heartbeat);
+    *last_snapshot()
+        .lock()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())? = Some(current.clone());
+    let changed = ManagedReadinessChangedV1 {
+        snapshot: current,
+        reason,
+    };
+    serde_json::to_value(changed)
+        .map(Some)
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())
+}
+
+/// Recheck the active Windows child/session fence immediately before every
+/// managed tool dispatch. The one-second heartbeat is the controller's
+/// revocation signal, but it is not itself a call gate: a lock, fast-user
+/// switch, or secure-desktop transition can happen between heartbeats.
+pub fn pre_dispatch_guard() -> Result<(), String> {
+    if !crate::ling_managed::is_managed() {
+        return Ok(());
+    }
+
+    #[cfg(target_os = "windows")]
+    {
+        let request = active_request()
+            .lock()
+            .map_err(|_| "cua_windows_platform_unavailable".to_owned())?
+            .clone()
+            .ok_or_else(|| "cua_windows_platform_unavailable".to_owned())?;
+        let current = snapshot_for_request(&request)?;
+        validate_dispatch_snapshot(&current)?;
+        *last_snapshot()
+            .lock()
+            .map_err(|_| "cua_windows_platform_unavailable".to_owned())? = Some(current);
+    }
+
+    Ok(())
+}
+
+#[cfg(any(test, target_os = "windows"))]
+fn validate_dispatch_snapshot(snapshot: &ManagedReadinessV1) -> Result<(), String> {
+    snapshot
+        .validate()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())?;
+    if snapshot.host_session_id == 0
+        || snapshot.provider_session_id == 0
+        || snapshot.host_session_id != snapshot.provider_session_id
+        || snapshot.input_desktop != InputDesktopState::DefaultUnlocked
+    {
+        return Err("cua_windows_interactive_session_required".to_owned());
+    }
+    Ok(())
+}
+
+fn parse_request(params: Option<&Value>) -> Result<ManagedReadinessRequestV1, String> {
+    let value = params.ok_or_else(|| "cua_windows_readiness_request_invalid".to_owned())?;
+    let request: ManagedReadinessRequestV1 = serde_json::from_value(value.clone())
+        .map_err(|_| "cua_windows_readiness_request_invalid".to_owned())?;
+    request
+        .validate()
+        .map_err(|_| "cua_windows_readiness_request_invalid".to_owned())?;
+    Ok(request)
+}
+
+fn snapshot_for_request(request: &ManagedReadinessRequestV1) -> Result<ManagedReadinessV1, String> {
+    let provider = PROVIDER
+        .get()
+        .ok_or_else(|| "cua_windows_platform_unavailable".to_owned())?;
+    let mut value = provider.snapshot(request)?;
+    if value.child_instance_nonce != request.child_instance_nonce
+        || value.lease_generation != request.lease_generation
+    {
+        return Err("cua_windows_readiness_identity_mismatch".to_owned());
+    }
+    value.readiness_sequence = NEXT_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    value
+        .validate()
+        .map_err(|_| "cua_windows_platform_unavailable".to_owned())?;
+    Ok(value)
+}
+
+fn change_reason(old: &ManagedReadinessV1, new: &ManagedReadinessV1) -> ReadinessChangeReason {
+    if old.host_session_id != new.host_session_id
+        || old.provider_session_id != new.provider_session_id
+    {
+        return ReadinessChangeReason::SessionMismatch;
+    }
+    if old.input_desktop != new.input_desktop {
+        return match (old.input_desktop, new.input_desktop) {
+            (InputDesktopState::DefaultUnlocked, InputDesktopState::Locked) => {
+                ReadinessChangeReason::Lock
+            }
+            (InputDesktopState::Locked, InputDesktopState::DefaultUnlocked) => {
+                ReadinessChangeReason::Unlock
+            }
+            _ => ReadinessChangeReason::InputDesktopChanged,
+        };
+    }
+    ReadinessChangeReason::Heartbeat
+}
+
+fn active_request() -> &'static Mutex<Option<ManagedReadinessRequestV1>> {
+    ACTIVE_REQUEST.get_or_init(|| Mutex::new(None))
+}
+
+fn last_snapshot() -> &'static Mutex<Option<ManagedReadinessV1>> {
+    LAST_SNAPSHOT.get_or_init(|| Mutex::new(None))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn request() -> ManagedReadinessRequestV1 {
+        ManagedReadinessRequestV1 {
+            schema_version: SCHEMA_VERSION,
+            child_instance_nonce: "new".into(),
+            lease_generation: 2,
+        }
+    }
+
+    fn value() -> ManagedReadinessV1 {
+        ManagedReadinessV1 {
+            schema_version: SCHEMA_VERSION,
+            child_instance_nonce: "new".into(),
+            lease_generation: 2,
+            readiness_sequence: 1,
+            host_process_id: 20,
+            host_session_id: 1,
+            host_integrity_level: ProcessIntegrityLevel::Medium,
+            provider_process_id: 10,
+            provider_session_id: 1,
+            provider_integrity_level: ProcessIntegrityLevel::Medium,
+            input_desktop: InputDesktopState::DefaultUnlocked,
+            job_object_assigned: true,
+            kill_on_job_close: true,
+            uia_runtime: RuntimeAvailability::Available,
+            d3d11: RuntimeAvailability::Available,
+            wgc_api: WgcApiSupport::Supported,
+            content_observed: false,
+        }
+    }
+
+    #[test]
+    fn stale_nonce_and_generation_are_not_current() {
+        let current = value();
+        assert!(current.is_current_for(&request()));
+        let mut stale = request();
+        stale.child_instance_nonce = "old".into();
+        assert!(!current.is_current_for(&stale));
+        stale.child_instance_nonce = "new".into();
+        stale.lease_generation = 3;
+        assert!(!current.is_current_for(&stale));
+    }
+
+    #[test]
+    fn wire_names_are_camel_case_and_content_is_false() {
+        let json = serde_json::to_value(value()).unwrap();
+        assert!(json.get("readinessSequence").is_some());
+        assert!(json.get("providerProcessId").is_some());
+        assert_eq!(json.get("contentObserved"), Some(&Value::Bool(false)));
+        assert!(json.get("readiness_sequence").is_none());
+    }
+
+    #[test]
+    fn session_zero_remains_structured_evidence_for_the_controller() {
+        let mut value = value();
+        value.host_session_id = 0;
+        value.provider_session_id = 0;
+        assert!(value.validate().is_ok());
+    }
+
+    #[test]
+    fn request_rejects_unknown_fields() {
+        let json = serde_json::json!({
+            "schemaVersion": 1,
+            "childInstanceNonce": "n",
+            "leaseGeneration": 1,
+            "unexpected": true
+        });
+        assert!(serde_json::from_value::<ManagedReadinessRequestV1>(json).is_err());
+    }
+
+    #[test]
+    fn pre_dispatch_rejects_locked_non_default_and_mismatched_sessions() {
+        let mut current = value();
+        assert!(validate_dispatch_snapshot(&current).is_ok());
+
+        current.input_desktop = InputDesktopState::Locked;
+        assert_eq!(
+            validate_dispatch_snapshot(&current).unwrap_err(),
+            "cua_windows_interactive_session_required"
+        );
+        current.input_desktop = InputDesktopState::NonDefault;
+        assert_eq!(
+            validate_dispatch_snapshot(&current).unwrap_err(),
+            "cua_windows_interactive_session_required"
+        );
+        current.input_desktop = InputDesktopState::DefaultUnlocked;
+        current.provider_session_id = 2;
+        assert_eq!(
+            validate_dispatch_snapshot(&current).unwrap_err(),
+            "cua_windows_interactive_session_required"
+        );
+        current.host_session_id = 0;
+        current.provider_session_id = 0;
+        assert_eq!(
+            validate_dispatch_snapshot(&current).unwrap_err(),
+            "cua_windows_interactive_session_required"
+        );
+    }
+}
