+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn classifies_desktop_without_returning_desktop_content() {
+        let state = crate::diagnostics::DesktopState {
+            session_id: Some(1),
+            has_process_window_station: true,
+            process_window_station_error: None,
+            thread_desktop_name: Some("Default".into()),
+            thread_desktop_error: None,
+            input_desktop_name: Some("Default".into()),
+            input_desktop_error: None,
+            foreground_hwnd: None,
+        };
+        assert_eq!(
+            classify_input_desktop(&state, Some(false)),
+            InputDesktopState::Locked
+        );
+        assert_eq!(
+            classify_input_desktop(&state, Some(true)),
+            InputDesktopState::DefaultUnlocked
+        );
+    }
+}
