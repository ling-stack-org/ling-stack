+#[cfg(target_os = "windows")]
+fn process_integrity(pid: u32) -> ProcessIntegrityLevel {
+    use windows::Win32::Foundation::{CloseHandle, HANDLE};
+    use windows::Win32::Security::{
+        GetSidSubAuthority, GetSidSubAuthorityCount, GetTokenInformation, TokenIntegrityLevel,
+        TOKEN_MANDATORY_LABEL, TOKEN_QUERY,
+    };
+    use windows::Win32::System::Threading::{
+        GetCurrentProcess, OpenProcess, OpenProcessToken, PROCESS_QUERY_LIMITED_INFORMATION,
+    };
+
+    let process = unsafe {
+        if pid == std::process::id() {
+            GetCurrentProcess()
+        } else {
+            match OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) {
+                Ok(handle) => handle,
+                Err(_) => return ProcessIntegrityLevel::Unknown,
+            }
+        }
+    };
+    let mut token = HANDLE::default();
+    if unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) }.is_err() {
+        if pid != std::process::id() {
+            unsafe {
+                let _ = CloseHandle(process);
+            }
+        }
+        return ProcessIntegrityLevel::Unknown;
+    }
+    let mut needed = 0;
+    unsafe {
+        let _ = GetTokenInformation(token, TokenIntegrityLevel, None, 0, &mut needed);
+    }
+    if needed == 0 {
+        unsafe {
+            let _ = CloseHandle(token);
+            if pid != std::process::id() {
+                let _ = CloseHandle(process);
+            }
+        }
+        return ProcessIntegrityLevel::Unknown;
+    }
+    let mut buffer = vec![0u8; needed as usize];
+    let ok = unsafe {
+        GetTokenInformation(
+            token,
+            TokenIntegrityLevel,
+            Some(buffer.as_mut_ptr() as _),
+            needed,
+            &mut needed,
+        )
+        .is_ok()
+    };
+    let level = if !ok {
+        ProcessIntegrityLevel::Unknown
+    } else {
+        let label = unsafe { &*(buffer.as_ptr() as *const TOKEN_MANDATORY_LABEL) };
+        let count = unsafe { *GetSidSubAuthorityCount(label.Label.Sid) };
+        if count == 0 {
+            ProcessIntegrityLevel::Unknown
+        } else {
+            let rid = unsafe { *GetSidSubAuthority(label.Label.Sid, (count - 1) as u32) };
+            match rid {
+                0x2000 | 0x2100 => ProcessIntegrityLevel::Medium,
+                0x3000 => ProcessIntegrityLevel::High,
+                0x4000 => ProcessIntegrityLevel::System,
+                _ => ProcessIntegrityLevel::Unknown,
+            }
+        }
+    };
+    unsafe {
+        let _ = CloseHandle(token);
+        if pid != std::process::id() {
+            let _ = CloseHandle(process);
+        }
+    }
+    level
+}
+
+#[cfg(not(target_os = "windows"))]
+fn process_integrity(_pid: u32) -> ProcessIntegrityLevel {
+    ProcessIntegrityLevel::Unknown
+}
