+//! Live readiness provider for the bundled standard Windows child.
+//!
+//! Every field is derived from the current process/session and current input
+//! desktop. No screenshot, window title, typed text, or native error detail is
+//! returned. The core module adds the monotonic sequence and emits the private
+//! heartbeat notification after the first authenticated request.
+
+use cua_driver_core::ling_managed_readiness::{
+    InputDesktopState, ManagedReadinessRequestV1, ManagedReadinessV1, ProcessIntegrityLevel,
+    Provider, RuntimeAvailability,
+};
+use std::sync::{Arc, OnceLock};
+
+#[derive(Debug, Clone, Copy, Default)]
+struct JobObjectState {
+    assigned: bool,
+    kill_on_close: bool,
+}
+
+static JOB_OBJECT_STATE: OnceLock<JobObjectState> = OnceLock::new();
+
+pub fn set_job_object_state(assigned: bool, kill_on_close: bool) {
+    let _ = JOB_OBJECT_STATE.set(JobObjectState {
+        assigned,
+        kill_on_close,
+    });
+}
+
+pub fn register() -> bool {
+    cua_driver_core::ling_managed_readiness::set_provider(Arc::new(WindowsReadiness))
+}
+
+struct WindowsReadiness;
+
+impl Provider for WindowsReadiness {
+    fn snapshot(&self, request: &ManagedReadinessRequestV1) -> Result<ManagedReadinessV1, String> {
+        let nonce = std::env::var("CUA_DRIVER_CHILD_INSTANCE_NONCE")
+            .map_err(|_| "cua_windows_platform_unavailable".to_owned())?;
+        let generation = std::env::var("CUA_DRIVER_LEASE_GENERATION")
+            .ok()
+            .and_then(|value| value.parse::<u64>().ok())
+            .filter(|value| *value > 0)
+            .ok_or_else(|| "cua_windows_platform_unavailable".to_owned())?;
+        if request.child_instance_nonce != nonce || request.lease_generation != generation {
+            return Err("cua_windows_readiness_identity_mismatch".to_owned());
+        }
+
+        let provider_process_id = std::process::id();
+        let provider_session_id = current_session(provider_process_id).unwrap_or(0);
+        let host_process_id = std::env::var("CUA_DRIVER_HOST_PID")
+            .ok()
+            .and_then(|value| value.parse::<u32>().ok())
+            .filter(|value| *value > 0)
+            .ok_or_else(|| "cua_windows_platform_unavailable".to_owned())?;
+        let host_session_id = current_session(host_process_id).unwrap_or(0);
+        let provider_integrity_level = process_integrity(provider_process_id);
+        let host_integrity_level = process_integrity(host_process_id);
+        let desktop = crate::diagnostics::desktop_state();
+        let input_desktop =
+            classify_input_desktop(&desktop, session_is_active(provider_session_id));
+        let uia_runtime = if crate::diagnostics::ui_automation_available().is_ok() {
+            RuntimeAvailability::Available
+        } else {
+            RuntimeAvailability::Unavailable
+        };
+        let d3d11 = if crate::health_report::probe_d3d11_device().is_ok() {
+            RuntimeAvailability::Available
+        } else {
+            RuntimeAvailability::Unavailable
+        };
+        let (job_object_assigned, kill_on_job_close) = JOB_OBJECT_STATE
+            .get()
+            .copied()
+            .map(|state| (state.assigned, state.kill_on_close))
+            .unwrap_or_default();
+
+        Ok(ManagedReadinessV1 {
+            schema_version: 1,
+            child_instance_nonce: nonce,
+            lease_generation: generation,
+            readiness_sequence: 0,
+            host_process_id,
+            host_session_id,
+            host_integrity_level,
+            provider_process_id,
+            provider_session_id,
+            provider_integrity_level,
+            input_desktop,
+            job_object_assigned,
+            kill_on_job_close,
+            uia_runtime,
+            d3d11,
+            wgc_api: crate::health_report::wgc_api_support(),
+            content_observed: false,
+        })
+    }
+}
+
+fn classify_input_desktop(
+    state: &crate::diagnostics::DesktopState,
+    session_active: Option<bool>,
+) -> InputDesktopState {
+    let Some(name) = state.input_desktop_name.as_deref() else {
+        return InputDesktopState::Unavailable;
+    };
+    if !name.eq_ignore_ascii_case("default") {
+        return InputDesktopState::NonDefault;
+    }
+    match session_active {
+        Some(true) => InputDesktopState::DefaultUnlocked,
+        Some(false) => InputDesktopState::Locked,
+        None if state.has_foreground_window() => InputDesktopState::DefaultUnlocked,
+        None => InputDesktopState::Unavailable,
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn session_is_active(session_id: u32) -> Option<bool> {
+    use windows::Win32::System::RemoteDesktop::{
+        WTSActive, WTSConnectState, WTSFreeMemory, WTSQuerySessionInformationW,
+        WTS_CONNECTSTATE_CLASS, WTS_CURRENT_SERVER_HANDLE,
+    };
+
+    let mut buffer = windows::core::PWSTR::null();
+    let mut bytes = 0u32;
+    unsafe {
+        WTSQuerySessionInformationW(
+            WTS_CURRENT_SERVER_HANDLE,
+            session_id,
+            WTSConnectState,
+            &mut buffer,
+            &mut bytes,
+        )
+        .ok()?;
+    }
+    let result = if bytes as usize >= std::mem::size_of::<WTS_CONNECTSTATE_CLASS>() {
+        Some(unsafe { *(buffer.0 as *const WTS_CONNECTSTATE_CLASS) } == WTSActive)
+    } else {
+        None
+    };
+    unsafe {
+        WTSFreeMemory(buffer.0.cast());
+    }
+    result
+}
+
+#[cfg(not(target_os = "windows"))]
+fn session_is_active(_session_id: u32) -> Option<bool> {
+    None
+}
