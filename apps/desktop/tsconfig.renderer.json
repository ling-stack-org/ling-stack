{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"]
  },
  "include": ["renderer/**/*.ts", "renderer/**/*.tsx", "shared/**/*.ts"]
}
