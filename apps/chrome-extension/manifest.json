{
  "manifest_version": 3,
  "name": "Ling for Chrome",
  "short_name": "Ling",
  "version": "0.1.2",
  "version_name": "0.1.2",
  "description": "Let Ling work with tabs you explicitly connect in Chrome.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ling for Chrome"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
