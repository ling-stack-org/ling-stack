{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "react": ["./node_modules/react-types-mobile/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/react-types-mobile/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/react-types-mobile/jsx-dev-runtime.d.ts"]
    },
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["react-types-mobile", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "test"]
}
