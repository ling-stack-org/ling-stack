{
  "name": "@ling-stack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:deps": "corepack pnpm --filter @ling-stack/remote-client build",
    "prestart": "corepack pnpm run build:deps",
    "start": "expo start --dev-client",
    "preandroid": "corepack pnpm run build:deps",
    "android": "expo run:android",
    "preios": "corepack pnpm run build:deps",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor .",
    "verify:native-evidence": "node scripts/verify-native-key-evidence.mjs",
    "typecheck": "corepack pnpm --filter @ling-stack/remote-client build && tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/remote-client": "workspace:*",
    "@ling-stack/remote-protocol": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "expo-doctor": "1.20.1",
    "react-types-mobile": "npm:@types/react@19.2.17",
    "typescript": "~6.0.3"
  }
}
