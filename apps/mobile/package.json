{
  "name": "@ling-stack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:deps": "corepack pnpm --filter @ling-stack/conversation-ui-core build && corepack pnpm --filter @ling-stack/remote-client build",
    "prestart": "corepack pnpm run build:deps",
    "start": "expo start --dev-client",
    "preandroid": "corepack pnpm run build:deps",
    "android": "expo run:android",
    "preios": "corepack pnpm run build:deps",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor .",
    "verify:native-evidence": "node scripts/verify-native-key-evidence.mjs",
    "typecheck": "corepack pnpm run build:deps && tsc --noEmit",
    "test": "corepack pnpm run build:deps && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/conversation-ui-core": "workspace:*",
    "@ling-stack/remote-client": "workspace:*",
    "@ling-stack/remote-protocol": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0"
  },
  "devDependencies": {
    "expo-doctor": "1.20.2",
    "react-types-mobile": "npm:@types/react@19.2.17",
    "typescript": "~7.0.2"
  }
}
