{
  "name": "@ling-stack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:ci": "echo \"Mobile runtime has no standalone build artifact; workspace dependencies are built by CI.\"",
    "typecheck:ci": "tsc --noEmit",
    "test:ci": "node --experimental-strip-types --test test/*.test.mjs",
    "build:deps": "corepack pnpm --filter @ling-stack/conversation-ui-core build && corepack pnpm --filter @ling-stack/remote-client build",
    "prestart": "corepack pnpm run build:deps",
    "start": "expo start --dev-client",
    "preandroid": "corepack pnpm run build:deps",
    "android": "expo run:android",
    "preios": "corepack pnpm run build:deps",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor .",
    "verify:native-evidence": "node scripts/verify-native-key-evidence.mjs",
    "typecheck": "corepack pnpm run build:deps && tsc --noEmit",
    "test": "corepack pnpm run build:deps && node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/conversation-ui-core": "workspace:*",
    "@ling-stack/remote-client": "workspace:*",
    "@ling-stack/remote-protocol": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-network": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "@expo/dom-webview": "~58.0.2"
  },
  "devDependencies": {
    "expo-doctor": "1.21.4",
    "react-dom": "19.3.0",
    "react-types-mobile": "npm:@types/react@19.3.0",
    "typescript": "~7.0.2"
  }
}
