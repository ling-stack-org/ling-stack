{
  "name": "@ling-stack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:deps": "corepack pnpm --filter @ling-stack/remote-protocol build",
    "prestart": "corepack pnpm run build:deps",
    "start": "expo start --dev-client",
    "preandroid": "corepack pnpm run build:deps",
    "android": "expo run:android",
    "preios": "corepack pnpm run build:deps",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor .",
    "verify:native-evidence": "node scripts/verify-native-key-evidence.mjs",
    "typecheck": "corepack pnpm --filter @ling-stack/remote-protocol build && tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/remote-protocol": "workspace:*",
    "expo": "~57.0.7",
    "expo-dev-client": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "expo-doctor": "1.20.1",
    "react-types-mobile": "npm:@types/react@19.2.17",
    "typescript": "~6.0.3"
  }
}
