{
  "name": "ling-stack",
  "private": true,
  "version": "0.1.2-alpha.1",
  "description": "Multilingual local-first AI teammate workspace with first-class domestic AI providers, GPT, Claude, and OpenAI-compatible relays.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm --workspace-concurrency=1 -r build",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "check:i18n": "corepack pnpm --filter @ling-stack/localization test && corepack pnpm --filter @ling-stack/web check:i18n",
    "i18n:import-legacy": "corepack pnpm --filter @ling-stack/localization catalog:import-legacy",
    "i18n:translate": "corepack pnpm --filter @ling-stack/localization catalog:translate --",
    "i18n:check": "corepack pnpm --filter @ling-stack/localization catalog:check",
    "i18n:compile": "corepack pnpm --filter @ling-stack/localization catalog:compile",
    "check:licenses": "node scripts/check-license-policy.mjs",
    "check:public": "node scripts/check-public-repo-safety.mjs",
    "check:dependency-security": "corepack pnpm --filter @ling-stack/mobile exec node --test test/dependency-security-patches.test.mjs && corepack pnpm --filter @ling-stack/daemon exec node --test test/dependency-security.test.mjs && node --test scripts/dependency-security-regressions.test.mjs",
    "typecheck": "corepack pnpm --workspace-concurrency=1 -r typecheck",
    "ling": "node packages/cli/dist/index.js",
    "local:restart": "node packages/cli/dist/index.js restart",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "ai",
    "agent",
    "workspace",
    "mcp",
    "openai",
    "anthropic",
    "doubao",
    "minimax",
    "glm"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "http-cache-semantics",
      "image-size"
    ],
    "overrides": {
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "hono@>=4.0.0 <4.13.7": "4.13.7",
      "ip-address@>=10.0.0 <10.7.1": "10.7.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@>=8.0.0 <=8.5.17": "8.5.25",
      "protobufjs@>=7.5.0 <7.6.5": "7.6.5",
      "tar@>=7.0.0 <=7.5.20": "7.5.22",
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "uuid@7.0.3": "11.1.1",
      "officeparser>pdfjs-dist": "6.2.108",
      "undici@>=8.0.0 <8.10.2": "8.11.2",
      "katex@>=0.11.0 <0.18.2": "0.19.0"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch",
      "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch"
    }
  }
}
