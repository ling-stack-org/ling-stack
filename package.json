{
  "name": "ling-stack",
  "private": true,
  "version": "0.1.1",
  "description": "Multilingual local-first AI teammate workspace with first-class domestic AI providers, GPT, Claude, and OpenAI-compatible relays.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm --workspace-concurrency=1 -r build",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "check:licenses": "node scripts/check-license-policy.mjs",
    "check:public": "node scripts/check-public-repo-safety.mjs",
    "check:dependency-security": "corepack pnpm --filter @ling-stack/mobile exec node --test test/dependency-security-patches.test.mjs && corepack pnpm --filter @ling-stack/daemon exec node --test test/dependency-security.test.mjs",
    "typecheck": "corepack pnpm --workspace-concurrency=1 -r typecheck",
    "ling": "node packages/cli/dist/index.js",
    "local:restart": "node packages/cli/dist/index.js restart",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "ai",
    "agent",
    "workspace",
    "mcp",
    "openai",
    "anthropic",
    "doubao",
    "minimax",
    "glm"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@>=1.0.0 <1.1.17": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.3": "2.1.4",
      "brace-expansion@5.0.6": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.5",
      "hono@>=4.0.0 <4.12.34": "4.12.34",
      "ip-address@>=10.0.0 <=10.3.0": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "postcss@>=8.0.0 <=8.5.17": "8.5.25",
      "protobufjs@>=7.5.0 <7.6.5": "7.6.5",
      "tar@>=7.0.0 <=7.5.20": "7.5.22",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "uuid@7.0.3": "11.1.1",
      "officeparser>pdfjs-dist": "6.2.108"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
