{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ling-stack.dev/schemas/windows-handoff-index-v1.json",
  "title": "Ling Windows acceptance handoff index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "createdAt",
    "candidateCommit",
    "signingTier",
    "distributionChannel",
    "productionEligible",
    "testAuthorityKind",
    "candidateManifest",
    "releasePolicy",
    "artifacts",
    "harness",
    "cellManifestDirectory",
    "reportDirectory",
    "requiredAcceptanceCells"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ling.windows.handoff-index" },
    "createdAt": { "type": "string", "format": "date-time" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "signingTier": { "enum": ["test_signed_internal", "production_signed"] },
    "distributionChannel": { "enum": ["internal", "production"] },
    "productionEligible": { "type": "boolean" },
    "testAuthorityKind": {
      "type": ["string", "null"],
      "enum": ["ephemeral-ci", "managed-internal", null]
    },
    "candidateManifest": { "$ref": "#/$defs/fileReference" },
    "releasePolicy": { "$ref": "#/$defs/fileReference" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "harness": { "$ref": "#/$defs/harness" },
    "cellManifestDirectory": { "$ref": "#/$defs/safeRelativePath" },
    "reportDirectory": { "$ref": "#/$defs/safeRelativePath" },
    "requiredAcceptanceCells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/acceptanceCell" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "signingTier": { "const": "test_signed_internal" } } },
      "then": {
        "properties": {
          "distributionChannel": { "const": "internal" },
          "productionEligible": { "const": false },
          "testAuthorityKind": { "enum": ["ephemeral-ci", "managed-internal"] }
        }
      }
    },
    {
      "if": { "properties": { "signingTier": { "const": "production_signed" } } },
      "then": {
        "properties": {
          "distributionChannel": { "const": "production" },
          "productionEligible": { "const": true },
          "testAuthorityKind": { "const": null }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|[/\\\\]|.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safeRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lingApp", "lingInstaller", "lingUninstaller", "provider", "providerSeal", "providerCatalog"],
      "properties": {
        "lingApp": { "$ref": "#/$defs/fileReference" },
        "lingInstaller": { "$ref": "#/$defs/fileReference" },
        "lingUninstaller": { "$ref": "#/$defs/fileReference" },
        "provider": { "$ref": "#/$defs/fileReference" },
        "providerSeal": { "$ref": "#/$defs/fileReference" },
        "providerCatalog": { "$ref": "#/$defs/fileReference" }
      }
    },
    "harnessFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/safeRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "files"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/harnessFile" }
        }
      }
    },
    "acceptanceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "windowsBuild", "architecture", "displayTopology", "displayScalePercents", "requiredEvidenceKinds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "windowsBuild": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x64" },
        "displayTopology": { "enum": ["single", "dual"] },
        "displayScalePercents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": [100, 150, 200] }
        },
        "requiredEvidenceKinds": {
          "const": ["accessibility", "display", "install-lifecycle", "provider-runtime"]
        }
      }
    }
  }
}
