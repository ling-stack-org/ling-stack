{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ling-stack.dev/schemas/macos-signed-performance-v1.json",
  "title": "Ling Desktop macOS Signed Performance Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "candidate",
    "executable",
    "host",
    "producer",
    "limitations",
    "cycles",
    "releaseBudgetComparison",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ling-desktop-macos-signed-performance" },
    "harness": { "$ref": "#/$defs/releaseHarness" },
    "candidate": {
      "type": "object",
      "required": ["reportSha256", "teamId", "bundleFingerprint"],
      "properties": {
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "teamId": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "bundleFingerprint": { "$ref": "#/$defs/bundleFingerprint" }
      }
    },
    "executable": {
      "type": "object",
      "required": ["path", "sha256", "architectures", "executionArchitecture", "bundleFingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "architectures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/architecture" } },
        "executionArchitecture": { "$ref": "#/$defs/architecture" },
        "bundleFingerprint": { "$ref": "#/$defs/bundleFingerprint" }
      }
    },
    "host": {
      "type": "object",
      "required": ["platform", "architecture", "macosVersion"],
      "properties": {
        "platform": { "const": "darwin" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "macosVersion": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "object",
      "required": ["signedReleaseEvidence"],
      "properties": { "signedReleaseEvidence": { "const": true } }
    },
    "producer": {
      "type": "object",
      "required": ["machineGenerated", "command", "script", "scriptSha256", "args"],
      "properties": {
        "machineGenerated": { "const": true },
        "command": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "scriptSha256": { "$ref": "#/$defs/sha256" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["baseline", "capture"],
        "properties": {
          "baseline": { "$ref": "#/$defs/cycleLane" },
          "capture": { "$ref": "#/$defs/cycleLane" }
        }
      }
    },
    "releaseBudgetComparison": {
      "type": "object",
      "required": ["pass"],
      "properties": { "pass": { "type": "boolean" } }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "pass"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "pass": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "releaseBudgetComparison": {
          "type": "object",
          "properties": { "pass": { "const": true } }
        },
        "verdict": {
          "type": "object",
          "properties": {
            "status": { "const": "PASS" },
            "pass": { "const": true }
          }
        }
      }
    },
    {
      "properties": {
        "releaseBudgetComparison": {
          "type": "object",
          "properties": { "pass": { "const": false } }
        },
        "verdict": {
          "type": "object",
          "properties": {
            "status": { "const": "FAIL" },
            "pass": { "const": false }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "architecture": { "const": "arm64" },
    "releaseHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "files"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "gitBlobObjectId"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "gitBlobObjectId": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              }
            }
          }
        }
      }
    },
    "bundleFingerprint": {
      "type": "object",
      "required": ["treeSha256", "cdhash"],
      "properties": {
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "cdhash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cdhashFull": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cycleLane": {
      "type": "object",
      "required": ["firstFrameLatencyMs", "rssSamplesBytes", "cpuSamples", "sampling"],
      "properties": {
        "firstFrameLatencyMs": { "type": "number", "minimum": 0 },
        "rssSamplesBytes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "cpuSamples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "sampling": {
          "type": "object",
          "required": ["intervalMs", "requestedHoldMs", "observedHoldMs", "sampleCount", "minimumSamples"],
          "properties": {
            "intervalMs": { "const": 100 },
            "requestedHoldMs": { "type": "integer", "minimum": 1 },
            "observedHoldMs": { "type": "integer", "minimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 1 },
            "minimumSamples": { "type": "integer", "minimum": 2 }
          }
        }
      }
    }
  }
}
