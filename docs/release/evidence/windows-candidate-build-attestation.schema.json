{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ling-stack.dev/schemas/windows-candidate-build-attestation-v1.json",
  "title": "Ling Desktop Windows Candidate Build Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scope",
    "candidateManifestSha256",
    "candidateCommit",
    "releasePolicySha256",
    "daemonPayload",
    "attestorId",
    "keyId",
    "attestedAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ling.windows.candidate-build-attestation" },
    "scope": { "const": "windows-candidate-build" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "releasePolicySha256": { "$ref": "#/$defs/sha256" },
    "daemonPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "strategy", "treeSha256"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "strategy": {
          "enum": ["deterministic-rebuild", "signed-candidate-embedded-daemon"]
        },
        "treeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestorId": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "attestedAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "valueBase64"],
      "properties": {
        "algorithm": { "const": "RSA-SHA256" },
        "valueBase64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
