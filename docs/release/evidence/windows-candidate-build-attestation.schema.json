{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ling-stack.dev/schemas/windows-candidate-build-attestation-v2.json",
  "title": "Ling Desktop Windows Candidate Build Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scope",
    "candidateManifestSha256",
    "candidateCommit",
    "releasePolicySha256",
    "signingTier",
    "distributionChannel",
    "productionEligible",
    "verdict",
    "daemonPayload",
    "attestorId",
    "keyId",
    "attestedAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "ling.windows.candidate-build-attestation" },
    "scope": { "const": "windows-signed-candidate-build" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "releasePolicySha256": { "$ref": "#/$defs/sha256" },
    "signingTier": { "enum": ["test_signed_internal", "production_signed"] },
    "distributionChannel": { "enum": ["internal", "production"] },
    "productionEligible": { "type": "boolean" },
    "verdict": { "enum": ["INTERNAL_TEST_PASS", "RELEASE_PASS"] },
    "daemonPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "strategy", "treeSha256"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "strategy": {
          "enum": ["deterministic-rebuild", "signed-candidate-embedded-daemon"]
        },
        "treeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestorId": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "attestedAt": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "oneOf": [
    {
      "properties": {
        "signingTier": { "const": "test_signed_internal" },
        "distributionChannel": { "const": "internal" },
        "productionEligible": { "const": false },
        "verdict": { "const": "INTERNAL_TEST_PASS" }
      }
    },
    {
      "properties": {
        "signingTier": { "const": "production_signed" },
        "distributionChannel": { "const": "production" },
        "productionEligible": { "const": true },
        "verdict": { "const": "RELEASE_PASS" }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "valueBase64"],
      "properties": {
        "algorithm": { "const": "RSA-SHA256" },
        "valueBase64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
