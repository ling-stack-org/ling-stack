{
  "name": "@ling-stack/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtin-extensions": {
      "types": "./dist/builtin-extensions.d.ts",
      "default": "./dist/builtin-extensions.js"
    },
    "./ai-council-view": {
      "types": "./dist/ai-council-view.d.ts",
      "default": "./dist/ai-council-view.js"
    },
    "./builtin-skill-packs": {
      "types": "./dist/builtin-skill-packs.d.ts",
      "default": "./dist/builtin-skill-packs.js"
    },
    "./skill-types": {
      "types": "./dist/skill-types.d.ts",
      "default": "./dist/skill-types.js"
    },
    "./composer-slash-intents": {
      "types": "./dist/composer-slash-intents.d.ts",
      "default": "./dist/composer-slash-intents.js"
    },
    "./provider-adapters": {
      "types": "./dist/provider-adapters.d.ts",
      "default": "./dist/provider-adapters.js"
    },
    "./provider-model-capabilities": {
      "types": "./dist/provider-model-capabilities.d.ts",
      "default": "./dist/provider-model-capabilities.js"
    },
    "./provider-generation-models": {
      "types": "./dist/provider-generation-models.d.ts",
      "default": "./dist/provider-generation-models.js"
    },
    "./provider-media-normalization": {
      "types": "./dist/provider-media-normalization.d.ts",
      "default": "./dist/provider-media-normalization.js"
    },
    "./session-permissions": {
      "types": "./dist/session-permissions.d.ts",
      "default": "./dist/session-permissions.js"
    }
  },
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit",
    "test:ci": "node --test test/*.test.mjs",
    "build": "corepack pnpm --filter @ling-stack/contracts build && corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/contracts build && corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/contracts build && corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/plugin-sdk": "workspace:*",
    "@ling-stack/localization": "workspace:*",
    "yaml": "^2.9.0"
  }
}
