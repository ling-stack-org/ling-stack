{
  "name": "@ling-stack/runner-pi",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test:ci": "node --test test/*.test.mjs test/*.test.ts",
    "build": "corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/plugin-sdk build && corepack pnpm typecheck:ci",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json && corepack pnpm test:ci"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@ling-stack/plugin-sdk": "workspace:*",
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
