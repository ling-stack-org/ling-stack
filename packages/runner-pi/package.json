{
  "name": "@ling-stack/runner-pi",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit",
    "test:ci": "node --test test/*.test.mjs",
    "build": "corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/plugin-sdk build && tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@ling-stack/plugin-sdk": "workspace:*",
    "undici": "8.11.2"
  }
}
