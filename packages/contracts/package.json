{
  "name": "@ling-stack/contracts",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures/channel-conversation-continuity-v2.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/channel-conversation-continuity-v2.json": "./fixtures/channel-conversation-continuity-v2.json"
  },
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:ci": "node --test test/*.test.mjs test/*.test.ts",
    "build": "corepack pnpm --filter @ling-stack/localization build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/localization build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/localization build && tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit && node --test test/*.test.mjs test/*.test.ts"
  },
  "dependencies": {
    "@ling-stack/localization": "workspace:*"
  }
}
