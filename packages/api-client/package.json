{
  "name": "@ling-stack/api-client",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:ci": "node --experimental-strip-types --test test/*.test.mjs test/*.test.ts",
    "build": "corepack pnpm --filter @ling-stack/contracts build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/contracts build && tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/contracts build && tsc -p tsconfig.json && node --experimental-strip-types --test test/*.test.mjs test/*.test.ts"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*"
  }
}
