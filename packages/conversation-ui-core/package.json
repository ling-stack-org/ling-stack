{
  "name": "@ling-stack/conversation-ui-core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
    "typecheck:ci": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test:ci": "node --test test/*.test.ts",
    "build": "corepack pnpm --filter @ling-stack/contracts build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --filter @ling-stack/conversation-ui-core... run build:ci && corepack pnpm typecheck:ci",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm typecheck && corepack pnpm test:ci"
  },
  "dependencies": {
    "@ling-stack/contracts": "workspace:*",
    "@ling-stack/localization": "workspace:*",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
