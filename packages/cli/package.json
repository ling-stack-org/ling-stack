{
  "name": "@ling-stack/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "ling-stack": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "corepack pnpm --filter @ling-stack/core build && corepack pnpm --filter @ling-stack/daemon build && tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ling-stack/core": "workspace:*",
    "@ling-stack/daemon": "workspace:*",
    "@ling-stack/web": "workspace:*"
  }
}
