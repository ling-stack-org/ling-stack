{
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "WebWorker.ImportScripts", "ScriptHost", "DOM.Iterable", "DOM.AsyncIterable", "ES2025.Float16"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
