{
  "name": "@ling-stack/remote-protocol",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/v1/canonical-signing.json": "./fixtures/v1/canonical-signing.json"
  },
  "scripts": {
    "build:ci": "tsc -p tsconfig.json",
