{
  "id": "official:office-documents",
  "displayName": "Ling Office Documents",
  "version": "0.1.0",
  "manifestVersion": 2,
  "lingInterfaceVersion": "2",
  "sourceKind": "official-remote",
  "trustLevel": "official",
  "description": "The signed Office document helper for Ling Desktop.",
  "trustSummary": "Official local Office helper. Document writes remain subject to Ling approvals.",
  "platforms": ["darwin", "win32"],
